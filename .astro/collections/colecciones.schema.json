{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "portada": {
      "type": "string"
    },
    "galeria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "orden": {
      "type": "number"
    },
    "destacado": {
      "default": true,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "titulo",
    "slug"
  ]
}