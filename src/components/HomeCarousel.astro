---
interface Item {
  titulo: string;
  slug: string;
  portada?: string;
  portadaMobile?: string;
  type: "pieces" | "collections";
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---
{items.length > 0 && (
  <div class="carousel" id="home-carousel">
    <div class="carousel__viewport anim-zoom-blur-in">
      <div class="carousel__track" id="carousel-track">
        {items.map((item) => (
          <a class="carousel__slide" href={`/${item.type}/${item.slug}`}>
            <span class="carousel__frame">
              {item.portada && (
                <img class="carousel__img carousel__img--desktop" src={item.portada} alt={item.titulo} loading="lazy" />
              )}
              {(item.portadaMobile || item.portada) && (
                <img
                  class="carousel__img carousel__img--mobile"
                  src={item.portadaMobile || item.portada}
                  alt={item.titulo}
                  loading="lazy"
                />
              )}
            </span>
          </a>
        ))}
      </div>

      {items.length > 1 && (
        <>
          <!-- Sin flechas visibles: la foto se parte en dos mitades — la
               izquierda va a la anterior, la derecha a la siguiente. En
               desktop el cursor personalizado cambia a una flecha ←/→
               según la mitad (ver Base.astro). -->
          <button type="button" class="carousel__nav carousel__nav--prev" id="carousel-prev" aria-label="Pieza anterior"></button>
          <button type="button" class="carousel__nav carousel__nav--next" id="carousel-next" aria-label="Siguiente pieza"></button>

          <div class="carousel__dots" id="carousel-dots">
            {items.map((_, i) => (
              <button type="button" class="carousel__dot" data-index={i} aria-label={`Ir a la pieza ${i + 1}`}></button>
            ))}
          </div>
        </>
      )}
    </div>
  </div>
)}

<script>
  const carousel = document.getElementById("home-carousel");
  if (carousel) {
    const track = document.getElementById("carousel-track") as HTMLElement;
    const prevBtn = document.getElementById("carousel-prev");
    const nextBtn = document.getElementById("carousel-next");
    const dotsWrap = document.getElementById("carousel-dots");

    // Orden aleatorio en cada carga (pedido de Daniel) — se reordenan los
    // slides y sus dots correspondientes (mismo índice) ANTES de que el
    // resto del script arranque, así todo lo de abajo (autoplay, flechas,
    // swipe) sigue funcionando igual sin saber ni importarle que el orden
    // real ya no es el del CMS.
    const shuffle = (n: number) => {
      const order = Array.from({ length: n }, (_, i) => i);
      for (let i = order.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [order[i], order[j]] = [order[j], order[i]];
      }
      return order;
    };
    const slideEls = Array.from(track.children);
    const dotEls = dotsWrap ? Array.from(dotsWrap.children) : [];
    const order = shuffle(slideEls.length);
    order.forEach((originalIndex) => {
      track.appendChild(slideEls[originalIndex]);
      if (dotsWrap) dotsWrap.appendChild(dotEls[originalIndex]);
    });

    const dots = dotsWrap ? Array.from(dotsWrap.querySelectorAll<HTMLButtonElement>(".carousel__dot")) : [];
    const slideCount = track.children.length;
    let index = 0;

    const render = () => {
      track.style.transform = `translateX(calc(${-index} * (100% + var(--slide-gap))))`;
      dots.forEach((dot, i) => dot.classList.toggle("is-active", i === index));
    };

    const go = (next: number) => {
      index = (next + slideCount) % slideCount;
      render();
    };

    // Autoplay — mismo comportamiento en desktop y mobile. Se reinicia cada
    // vez que el usuario navega a mano (flechas, dots, swipe) para que no
    // "pelee" saltando justo después de una interacción, y se pausa en
    // hover / pestaña oculta.
    const AUTOPLAY_MS = 10000;
    let autoplayTimer: ReturnType<typeof setInterval> | null = null;

    const stopAutoplay = () => {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    };

    const startAutoplay = () => {
      if (slideCount <= 1) return;
      stopAutoplay();
      autoplayTimer = setInterval(() => go(index + 1), AUTOPLAY_MS);
    };

    const goManual = (next: number) => {
      go(next);
      startAutoplay();
    };

    prevBtn?.addEventListener("click", () => goManual(index - 1));
    nextBtn?.addEventListener("click", () => goManual(index + 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => goManual(i)));

    carousel.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") goManual(index - 1);
      if (e.key === "ArrowRight") goManual(index + 1);
    });

    // Swipe: en el carrusel entero (no solo el track) — las mitades
    // clickeables lo tapan y los touch no llegarían al track.
    let touchStartX = 0;
    carousel.addEventListener("touchstart", (e) => {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });
    carousel.addEventListener("touchend", (e) => {
      const delta = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(delta) > 40) goManual(delta > 0 ? index - 1 : index + 1);
    }, { passive: true });

    carousel.addEventListener("mouseenter", stopAutoplay);
    carousel.addEventListener("mouseleave", startAutoplay);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stopAutoplay();
      else startAutoplay();
    });

    render();
    startAutoplay();
  }
</script>

<style>
  /* Container propio del home (no el --max-width de 1512 del resto del
     sitio) — con 100px de padding lateral en desktop (pedido del diseño,
     probado con Daniel). Sin max-width: el slider ya no tiene un tope de
     ancho, se dimensiona solo por el alto disponible (ver abajo) y encoge
     proporcional cuando la ventana se achica. */
  .carousel {
    margin: 0 auto;
    padding: 0 100px;
  }

  .carousel__viewport {
    /* El slider no cabe por un ancho fijo — cabe por el ALTO disponible
       (--carousel-avail-h, calculado en JS en index.astro a partir de
       header/footer para que la página entera quepa en un viewport sin
       scroll). El ancho es el menor entre "todo el ancho lateral
       disponible" y "el ancho que le tocaría a la foto si usara todo ese
       alto" — así nunca se distorsiona ni se corta el aspect ratio, y
       encoge solo si hace falta. */
    width: min(100%, calc(var(--carousel-avail-h, 620px) * 1039 / 705));
    margin: 0 auto;
    position: relative;
    overflow: hidden;
    background: var(--color-placeholder);
  }

  /* "Space between" como en Swiper: un hueco real entre slides (--slide-gap).
     Con slides pegados, cualquier redondeo de sub-píxel en el translateX
     deja ver una tirita de la foto vecina; con el hueco, lo único que
     puede asomar en reposo es fondo (el vecino queda a --slide-gap px de
     distancia, fuera del viewport). El desplazamiento por slide es
     100% + --slide-gap (ver render() en el script). */
  .carousel__track {
    --slide-gap: 12px;
    display: flex;
    gap: var(--slide-gap);
    transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .carousel__slide {
    flex: 0 0 100%;
    display: block;
    /* La rayita de 1px del slide vecino (sub-pixel rounding entre el ancho
       de cada slide y el % del transform, típico en carruseles con
       translateX(%)) es inevitable a nivel de layout — lo que hay que
       garantizar es que NUNCA se pinte fuera de su propia casilla. Antes
       cada slide no tenía su propio overflow:hidden (solo lo tenía el
       viewport, por fuera), así que cualquier desborde — de redondeo o de
       un intento anterior de "agrandar la foto para tapar el hueco", que
       terminó siendo MÁS visible, no menos — se veía sobre el vecino.
       Con overflow:hidden acá, cada foto queda recortada a su propia
       caja pase lo que pase. */
    overflow: hidden;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .carousel__frame {
    display: block;
    aspect-ratio: 1039 / 705;
  }

  .carousel__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Dos fotos por slide, una horizontal (escritorio) y una vertical
     (mobile) — no es la misma foto recortada distinto, son dos tomas
     propias. El media query de abajo decide cuál se ve y ajusta el aspect
     ratio de la caja a esa foto. */
  .carousel__img--mobile {
    display: none;
  }

  /* Mitades clickeables invisibles sobre la foto — izquierda = anterior,
     derecha = siguiente. Sin ícono propio: en desktop lo da el cursor
     personalizado (ver Base.astro). */
  .carousel__nav {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    z-index: 1;
  }
  .carousel__nav--prev {
    left: 0;
  }
  .carousel__nav--next {
    right: 0;
  }

  .carousel__dots {
    position: absolute;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%);
    display: flex;
    justify-content: center;
    gap: 10px;
    /* Encima de las mitades clickeables (z-index: 1) para seguir siendo
       clickeables. */
    z-index: 2;
  }
  .carousel__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    /* En transparencia (pedido de Daniel) — antes blanco sólido, se veía
       muy fuerte sobre algunos fondos claros de foto. */
    background: rgba(255, 255, 255, 0.45);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .carousel__dot.is-active {
    background: rgba(255, 255, 255, 0.85);
  }

  @media (max-width: 900px) {
    /* Mismo mecanismo que desktop (ver .carousel__viewport arriba) — menos
       padding lateral (40px, pedido del diseño) y el aspect ratio propio
       de la foto vertical de mobile. */
    .carousel {
      padding: 0 40px;
    }
    .carousel__viewport {
      width: min(100%, calc(var(--carousel-avail-h, 520px) * 2790 / 3360));
    }
    .carousel__frame {
      aspect-ratio: 2790 / 3360;
    }
    .carousel__img--desktop {
      display: none;
    }
    .carousel__img--mobile {
      display: block;
    }
  }
</style>
