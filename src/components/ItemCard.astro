---
interface Props {
  titulo: string;
  slug: string;
  portada?: string;
  type: "pieces" | "collections";
}
const { titulo, slug, portada, type } = Astro.props;
const href = `/${type}/${slug}`;
---
<a class="item-card" href={href}>
  <span class="item-card__frame">
    {portada && <img src={portada} alt={titulo} loading="lazy" />}
  </span>
  <span class="item-card__title">{titulo}</span>
</a>

<style>
  .item-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .item-card__frame {
    display: block;
    aspect-ratio: 333 / 401;
    background: var(--color-placeholder);
    overflow: hidden;
  }
  .item-card img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .item-card:hover img {
    transform: scale(1.1);
  }
  .item-card__title {
    display: block;
    margin-top: 20px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    /* Season Sans renders lowercase almost like small caps (versalitas) —
       feedback from Juanjo Romero: needs more tracking so it doesn't read
       cramped at this size. */
    letter-spacing: 0.4px;
  }
</style>
