---
interface Props {
  titulo: string;
  slug: string;
  portada?: string;
  type: "piezas" | "colecciones";
}
const { titulo, slug, portada, type } = Astro.props;
const href = `/${type}/${slug}`;
---
<a class="item-card" href={href}>
  {portada && <img src={portada} alt={titulo} loading="lazy" />}
  <span class="item-card__title">{titulo}</span>
</a>

<style>
  .item-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .item-card img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
  }
  .item-card__title {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.9rem;
  }
</style>
