---
import ItemCard from "./ItemCard.astro";

interface Item {
  titulo: string;
  slug: string;
  portada?: string;
  type: "piezas" | "colecciones";
}

interface Props {
  items: Item[];
  defaultCols?: number;
}

const { items, defaultCols = 4 } = Astro.props;
const MIN_COLS = 2;
const MAX_COLS = 8;
const DENSE_AT = 7;
---
<div class="work-grid">
  <div class="work-grid__toolbar">
    <span class="work-grid__toolbar-label type-meta">Vista</span>
    <input
      type="range"
      id="grid-cols-slider"
      class="work-grid__slider"
      min={MIN_COLS}
      max={MAX_COLS}
      step="1"
      value={defaultCols}
      aria-label="Columnas del grid"
    />
  </div>

  <section
    class:list={["grid", { "grid--dense": defaultCols >= DENSE_AT }]}
    id="grid"
    data-dense-at={DENSE_AT}
    style={`--cols: ${defaultCols};`}
  >
    {items.map((item) => (
      <ItemCard titulo={item.titulo} slug={item.slug} portada={item.portada} type={item.type} />
    ))}
  </section>
</div>

<script>
  const STORAGE_KEY = "work-grid-cols";
  const slider = document.getElementById("grid-cols-slider") as HTMLInputElement | null;
  const grid = document.getElementById("grid");

  if (slider && grid) {
    const denseAt = Number(grid.dataset.denseAt ?? "7");

    const applyCols = (value: string) => {
      grid.style.setProperty("--cols", value);
      grid.classList.toggle("grid--dense", Number(value) >= denseAt);
    };

    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored) {
      slider.value = stored;
      applyCols(stored);
    }

    slider.addEventListener("input", () => {
      applyCols(slider.value);
      localStorage.setItem(STORAGE_KEY, slider.value);
    });
  }
</script>

<style>
  .work-grid {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .work-grid__toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    padding: 12px var(--gutter) 0;
  }

  .work-grid__toolbar-label {
    color: var(--color-text-muted);
  }

  .work-grid__slider {
    -webkit-appearance: none;
    appearance: none;
    width: 70px;
    height: 14px;
    background: transparent;
    cursor: pointer;
  }
  .work-grid__slider:focus {
    outline: none;
  }
  .work-grid__slider::-webkit-slider-runnable-track {
    height: 1px;
    background: var(--color-hairline);
  }
  .work-grid__slider::-moz-range-track {
    height: 1px;
    background: var(--color-hairline);
  }
  .work-grid__slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-text);
    margin-top: -2.5px;
    transition: transform 0.15s ease;
  }
  .work-grid__slider::-webkit-slider-thumb:active {
    transform: scale(1.6);
  }
  .work-grid__slider::-moz-range-thumb {
    width: 6px;
    height: 6px;
    border: none;
    border-radius: 50%;
    background: var(--color-text);
    transition: transform 0.15s ease;
  }
  .work-grid__slider::-moz-range-thumb:active {
    transform: scale(1.6);
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--grid-gap);
    padding: 16px var(--gutter) 0;
  }

  .grid :global(.item-card) {
    flex: 0 0 calc((100% - (var(--cols) - 1) * var(--grid-gap)) / var(--cols));
    transition: flex-basis 0.35s ease;
  }

  .grid.grid--dense :global(.item-card__title) {
    display: none;
  }

  @media (max-width: 900px) {
    .work-grid__toolbar {
      display: none;
    }
    .grid {
      gap: 16px;
      padding-top: 24px;
    }
    .grid :global(.item-card) {
      flex-basis: calc(50% - 8px) !important;
    }
  }
</style>
