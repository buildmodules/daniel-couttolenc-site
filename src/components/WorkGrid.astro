---
import ItemCard from "./ItemCard.astro";

interface Item {
  titulo: string;
  slug: string;
  portada?: string;
  portadaHover?: string;
  type: "pieces" | "collections";
}

interface Props {
  items: Item[];
  defaultCols?: number;
}

const { items, defaultCols = 4 } = Astro.props;
// Solo 3 tamaños fijos en el track: izquierda = pequeño, centro = normal
// (default), derecha = grande. El slider mueve un índice (0, 1, 2) que se
// traduce a columnas via SIZES — distinto set en mobile (el track se
// re-lee según el viewport, ver el script). El índice default (1, centro)
// es el mismo en ambos sets a propósito, para no necesitar ninguna lógica
// extra al cambiar de viewport.
const SIZES = [8, 4, 2];
const SIZES_MOBILE = [4, 2, 1];
const DEFAULT_INDEX = SIZES.includes(defaultCols) ? SIZES.indexOf(defaultCols) : 1;
---
<div class="work-grid">
  <div class="work-grid__toolbar">
    <span class="work-grid__toolbar-label type-meta">Vista</span>
    <input
      type="range"
      id="grid-cols-slider"
      class="work-grid__slider"
      min="0"
      max="2"
      step="1"
      value={DEFAULT_INDEX}
      data-sizes={SIZES.join(",")}
      data-sizes-mobile={SIZES_MOBILE.join(",")}
      aria-label="Tamaño del grid"
    />
  </div>

  <section
    class:list={["grid", { "grid--dense": defaultCols >= Math.max(...SIZES) }]}
    id="grid"
    style={`--cols: ${defaultCols};`}
  >
    {items.map((item) => (
      <ItemCard
        titulo={item.titulo}
        slug={item.slug}
        portada={item.portada}
        portadaHover={item.portadaHover}
        type={item.type}
      />
    ))}
  </section>
</div>

<script>
  // Deliberately not persisted (localStorage/sessionStorage) — the slider
  // should always start at the default column count on a fresh page load,
  // even if the user changed it, navigated away, and came back to /work.
  const slider = document.getElementById("grid-cols-slider") as HTMLInputElement | null;
  const grid = document.getElementById("grid");

  if (slider && grid) {
    const sizesDesktop = (slider.dataset.sizes ?? "8,4,2").split(",").map(Number);
    const sizesMobile = (slider.dataset.sizesMobile ?? "4,2,1").split(",").map(Number);
    const mobileQuery = window.matchMedia("(max-width: 900px)");
    // El track tiene un set de columnas distinto en mobile — se relee en
    // cada uso (no una sola vez al cargar) para que un resize/rotación
    // cruzando el breakpoint tome el set correcto.
    const currentSizes = () => (mobileQuery.matches ? sizesMobile : sizesDesktop);

    // Animating `flex-basis` directly makes the browser recompute line-wrapping
    // at every intermediate value, so cards snap between rows mid-transition —
    // that's the "salto raro". Instead we jump flex-basis instantly and use a
    // FLIP animation (capture position/size before, then animate a compensating
    // transform back to identity) so the reflow itself reads as one smooth move.
    const applyIndex = (index: string) => {
      const sizes = currentSizes();
      const denseCols = Math.max(...sizes);
      const cols = sizes[Number(index)] ?? sizes[1];
      const cardEls = Array.from(grid.querySelectorAll<HTMLElement>(".item-card"));
      const frameEls = cardEls.map((c) => c.querySelector<HTMLElement>(".item-card__frame"));
      const titleEls = cardEls.map((c) => c.querySelector<HTMLElement>(".item-card__title"));

      // FIRST: record current geometry before the layout change.
      const firstFrame = frameEls.map((el) => el?.getBoundingClientRect() ?? null);
      const firstTitle = titleEls.map((el) => el?.getBoundingClientRect() ?? null);

      grid.style.setProperty("--cols", String(cols));
      grid.classList.toggle("grid--dense", cols >= denseCols);

      // LAST + INVERT: jump each element back to where it used to be, with no
      // transition, so the instant reflow above is invisible to the user.
      // The frame gets translate+scale (its size changes between stages); the
      // title only gets translate (its text must never stretch).
      frameEls.forEach((el, i) => {
        const first = firstFrame[i];
        if (!el || !first) return;
        const last = el.getBoundingClientRect();
        if (!last.width || !last.height) return;
        const dx = first.left - last.left;
        const dy = first.top - last.top;
        const sx = first.width / last.width;
        const sy = first.height / last.height;
        el.style.transformOrigin = "top left";
        el.style.transition = "none";
        el.style.transform = `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`;
      });
      titleEls.forEach((el, i) => {
        const first = firstTitle[i];
        if (!el || !first) return;
        const last = el.getBoundingClientRect();
        const dx = first.left - last.left;
        const dy = first.top - last.top;
        el.style.transition = "none";
        el.style.transform = `translate(${dx}px, ${dy}px)`;
      });

      // Force the browser to paint the inverted state above before re-enabling
      // the transition — otherwise it collapses straight to the end state.
      grid.getBoundingClientRect();

      // PLAY: animate back to the real (identity) transform.
      requestAnimationFrame(() => {
        frameEls.forEach((el) => {
          if (!el) return;
          el.style.transition = "transform 0.4s ease";
          el.style.transform = "";
        });
        titleEls.forEach((el) => {
          if (!el) return;
          el.style.transition = "transform 0.4s ease";
          el.style.transform = "";
        });
      });
    };

    slider.addEventListener("input", () => {
      applyIndex(slider.value);
    });

    // El markup se renderiza en el servidor asumiendo el set de escritorio
    // (--cols arranca en el valor default de ESE set) — en mobile hay que
    // corregirlo al montar, sin animar (nada que journeyar todavía). Mismo
    // índice (1, centro) en ambos sets, así que no hace falta tocar el
    // value del slider, solo qué columnas le corresponden.
    const syncToViewport = () => {
      const sizes = currentSizes();
      const denseCols = Math.max(...sizes);
      const cols = sizes[Number(slider.value)] ?? sizes[1];
      grid.style.setProperty("--cols", String(cols));
      grid.classList.toggle("grid--dense", cols >= denseCols);
    };
    syncToViewport();
    window.addEventListener("resize", syncToViewport);
  }
</script>

<style>
  .work-grid {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .work-grid__toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    padding: 12px var(--gutter) 0;
  }

  .work-grid__toolbar-label {
    color: var(--color-text-muted);
    font-size: 14px;
  }

  /* Slider 25% más grande que antes: pista 70→88px, dot 6→7.5px. */
  .work-grid__slider {
    -webkit-appearance: none;
    appearance: none;
    width: 88px;
    height: 18px;
    background: transparent;
    cursor: pointer;
  }
  .work-grid__slider:focus {
    outline: none;
  }
  .work-grid__slider::-webkit-slider-runnable-track {
    height: 1px;
    background: var(--color-hairline);
  }
  .work-grid__slider::-moz-range-track {
    height: 1px;
    background: var(--color-hairline);
  }
  .work-grid__slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 7.5px;
    height: 7.5px;
    border-radius: 50%;
    background: var(--color-text);
    margin-top: -3.25px;
    transition: transform 0.15s ease;
  }
  .work-grid__slider::-webkit-slider-thumb:active {
    transform: scale(1.6);
  }
  .work-grid__slider::-moz-range-thumb {
    width: 7.5px;
    height: 7.5px;
    border: none;
    border-radius: 50%;
    background: var(--color-text);
    transition: transform 0.15s ease;
  }
  .work-grid__slider::-moz-range-thumb:active {
    transform: scale(1.6);
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    /* --card-gap es el gap "real" que se está usando (column-gap), separado
       de --grid-gap (el valor base) porque la vista densa de mobile lo
       reduce a la mitad — el ancho de cada tarjeta tiene que calcularse con
       ese mismo valor o sobra espacio a la derecha (columnas angostas de
       más). Cualquier contexto que cambie el column-gap real debe
       redeclarar --card-gap, no solo la propiedad column-gap. */
    --card-gap: var(--grid-gap);
    column-gap: var(--card-gap);
    row-gap: 64px;
    padding: 16px var(--gutter) 0;
  }

  .grid :global(.item-card) {
    flex: 0 0 calc((100% - (var(--cols) - 1) * var(--card-gap)) / var(--cols));
  }

  .grid.grid--dense :global(.item-card__title) {
    display: none;
  }

  /* Vista de 8 columnas: sin título debajo de cada foto, así que el
     espacio entre filas puede ser tan angosto como el de columnas —
     solo aplica aquí, las vistas de 4 y 2 columnas mantienen el row-gap
     grande de arriba. */
  .grid.grid--dense {
    row-gap: var(--grid-gap);
  }

  @media (max-width: 900px) {
    /* El track de tamaño ahora también vive en mobile — mismo lugar que
       escritorio (arriba a la derecha), solo cambia el set de columnas
       (ver data-sizes-mobile / el script). */
    .grid {
      column-gap: var(--card-gap);
      /* Vistas de 2 y 1 columna (con título) — 30% más de aire entre filas
         que el gap base. */
      row-gap: calc(var(--grid-gap) * 1.3);
      padding-top: 24px;
    }
    /* Vista de 4 columnas en mobile (sin título) — gap 50% más chico que
       las otras dos vistas. .grid--dense en mobile es justo esta vista
       (el "denso" de escritorio, 8 cols, vive fuera de este media query).
       Redeclara --card-gap (no solo column-gap) para que el ancho de cada
       tarjeta se recalcule con el gap chico y no deje espacio vacío. */
    .grid.grid--dense {
      --card-gap: calc(var(--grid-gap) / 2);
      column-gap: var(--card-gap);
      row-gap: var(--card-gap);
    }

    /* El track "Vista" 30% más grande en mobile (pedido del diseño):
       88→114px de ancho, dot 7.5→9.75px, label 14→18px. */
    .work-grid__toolbar-label {
      font-size: 18px;
    }
    .work-grid__slider {
      width: 114px;
      height: 24px;
    }
    .work-grid__slider::-webkit-slider-thumb {
      width: 9.75px;
      height: 9.75px;
      margin-top: -4.375px;
    }
    .work-grid__slider::-moz-range-thumb {
      width: 9.75px;
      height: 9.75px;
    }

    /* El mini-slider por tarjeta (swipe portada ↔ hover, ver ItemCard.astro)
       NO aplica en la vista de 4 columnas — ahí las fotos son muy chicas y
       no hay dónde deslizar. Se vuelve a la foto de portada sola. */
    .grid.grid--dense :global(.item-card__frame) {
      display: block;
      overflow: visible;
    }
    .grid.grid--dense :global(.item-card__img--hover) {
      display: none;
    }
    .grid.grid--dense :global(.item-card__dots) {
      display: none;
    }
  }
</style>
