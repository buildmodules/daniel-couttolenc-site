---
import ItemCard from "./ItemCard.astro";

interface Item {
  titulo: string;
  slug: string;
  portada?: string;
  portadaHover?: string;
  type: "pieces" | "collections";
}

interface Props {
  items: Item[];
  defaultCols?: number;
}

const { items, defaultCols = 4 } = Astro.props;
// Solo 3 tamaños fijos en el track: izquierda = pequeño (8 columnas),
// centro = normal (4), derecha = grande (2). El slider mueve un índice
// (0, 1, 2) que se traduce a columnas via SIZES, no un valor continuo.
const SIZES = [8, 4, 2];
const DEFAULT_INDEX = SIZES.includes(defaultCols) ? SIZES.indexOf(defaultCols) : 1;
const DENSE_COLS = 8;
---
<div class="work-grid">
  <div class="work-grid__toolbar">
    <span class="work-grid__toolbar-label type-meta">Vista</span>
    <input
      type="range"
      id="grid-cols-slider"
      class="work-grid__slider"
      min="0"
      max="2"
      step="1"
      value={DEFAULT_INDEX}
      data-sizes={SIZES.join(",")}
      aria-label="Tamaño del grid"
    />
  </div>

  <section
    class:list={["grid", { "grid--dense": defaultCols >= DENSE_COLS }]}
    id="grid"
    style={`--cols: ${defaultCols};`}
  >
    {items.map((item) => (
      <ItemCard
        titulo={item.titulo}
        slug={item.slug}
        portada={item.portada}
        portadaHover={item.portadaHover}
        type={item.type}
      />
    ))}
  </section>
</div>

<script>
  // Deliberately not persisted (localStorage/sessionStorage) — the slider
  // should always start at the default column count on a fresh page load,
  // even if the user changed it, navigated away, and came back to /work.
  const slider = document.getElementById("grid-cols-slider") as HTMLInputElement | null;
  const grid = document.getElementById("grid");

  if (slider && grid) {
    const sizes = (slider.dataset.sizes ?? "8,4,2").split(",").map(Number);
    const denseCols = Math.max(...sizes);

    // Animating `flex-basis` directly makes the browser recompute line-wrapping
    // at every intermediate value, so cards snap between rows mid-transition —
    // that's the "salto raro". Instead we jump flex-basis instantly and use a
    // FLIP animation (capture position/size before, then animate a compensating
    // transform back to identity) so the reflow itself reads as one smooth move.
    const applyIndex = (index: string) => {
      const cols = sizes[Number(index)] ?? sizes[1];
      const cardEls = Array.from(grid.querySelectorAll<HTMLElement>(".item-card"));
      const frameEls = cardEls.map((c) => c.querySelector<HTMLElement>(".item-card__frame"));
      const titleEls = cardEls.map((c) => c.querySelector<HTMLElement>(".item-card__title"));

      // FIRST: record current geometry before the layout change.
      const firstFrame = frameEls.map((el) => el?.getBoundingClientRect() ?? null);
      const firstTitle = titleEls.map((el) => el?.getBoundingClientRect() ?? null);

      grid.style.setProperty("--cols", String(cols));
      grid.classList.toggle("grid--dense", cols >= denseCols);

      // LAST + INVERT: jump each element back to where it used to be, with no
      // transition, so the instant reflow above is invisible to the user.
      // The frame gets translate+scale (its size changes between stages); the
      // title only gets translate (its text must never stretch).
      frameEls.forEach((el, i) => {
        const first = firstFrame[i];
        if (!el || !first) return;
        const last = el.getBoundingClientRect();
        if (!last.width || !last.height) return;
        const dx = first.left - last.left;
        const dy = first.top - last.top;
        const sx = first.width / last.width;
        const sy = first.height / last.height;
        el.style.transformOrigin = "top left";
        el.style.transition = "none";
        el.style.transform = `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`;
      });
      titleEls.forEach((el, i) => {
        const first = firstTitle[i];
        if (!el || !first) return;
        const last = el.getBoundingClientRect();
        const dx = first.left - last.left;
        const dy = first.top - last.top;
        el.style.transition = "none";
        el.style.transform = `translate(${dx}px, ${dy}px)`;
      });

      // Force the browser to paint the inverted state above before re-enabling
      // the transition — otherwise it collapses straight to the end state.
      grid.getBoundingClientRect();

      // PLAY: animate back to the real (identity) transform.
      requestAnimationFrame(() => {
        frameEls.forEach((el) => {
          if (!el) return;
          el.style.transition = "transform 0.4s ease";
          el.style.transform = "";
        });
        titleEls.forEach((el) => {
          if (!el) return;
          el.style.transition = "transform 0.4s ease";
          el.style.transform = "";
        });
      });
    };

    slider.addEventListener("input", () => {
      applyIndex(slider.value);
    });
  }
</script>

<style>
  .work-grid {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .work-grid__toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    padding: 12px var(--gutter) 0;
  }

  .work-grid__toolbar-label {
    color: var(--color-text-muted);
  }

  .work-grid__slider {
    -webkit-appearance: none;
    appearance: none;
    width: 70px;
    height: 14px;
    background: transparent;
    cursor: pointer;
  }
  .work-grid__slider:focus {
    outline: none;
  }
  .work-grid__slider::-webkit-slider-runnable-track {
    height: 1px;
    background: var(--color-hairline);
  }
  .work-grid__slider::-moz-range-track {
    height: 1px;
    background: var(--color-hairline);
  }
  .work-grid__slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-text);
    margin-top: -2.5px;
    transition: transform 0.15s ease;
  }
  .work-grid__slider::-webkit-slider-thumb:active {
    transform: scale(1.6);
  }
  .work-grid__slider::-moz-range-thumb {
    width: 6px;
    height: 6px;
    border: none;
    border-radius: 50%;
    background: var(--color-text);
    transition: transform 0.15s ease;
  }
  .work-grid__slider::-moz-range-thumb:active {
    transform: scale(1.6);
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--grid-gap);
    row-gap: 64px;
    padding: 16px var(--gutter) 0;
  }

  .grid :global(.item-card) {
    flex: 0 0 calc((100% - (var(--cols) - 1) * var(--grid-gap)) / var(--cols));
  }

  .grid.grid--dense :global(.item-card__title) {
    display: none;
  }

  /* Vista de 8 columnas: sin título debajo de cada foto, así que el
     espacio entre filas puede ser tan angosto como el de columnas —
     solo aplica aquí, las vistas de 4 y 2 columnas mantienen el row-gap
     grande de arriba. */
  .grid.grid--dense {
    row-gap: var(--grid-gap);
  }

  @media (max-width: 900px) {
    .work-grid__toolbar {
      display: none;
    }
    .grid {
      gap: 16px;
      padding-top: 24px;
    }
    .grid :global(.item-card) {
      flex-basis: calc(50% - 8px) !important;
    }
  }
</style>
