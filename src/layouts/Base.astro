---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}

const SITE_NAME = "Daniel Couttolenc";
const DEFAULT_DESCRIPTION =
  "Daniel Couttolenc is a Mexican designer creating solid wood and cast bronze furniture and objects guided by proportion, geometry, and material exploration.";
const DEFAULT_IMAGE = "/images/Aster table/1.jpg";

const { title, description = DEFAULT_DESCRIPTION, image = DEFAULT_IMAGE, type = "website" } = Astro.props;
const pageTitle =
  title === SITE_NAME || title.includes(SITE_NAME) ? title : `${title} · ${SITE_NAME}`;
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
const canonicalUrl = new URL(path, Astro.site ?? Astro.url.origin).toString();
const absoluteImage = new URL(image, Astro.site ?? Astro.url.origin).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
  </head>
  <body>
    <header class="site-header">
      <a class="site-header__brand" href="/">
        <img src="/site/header-avatar.png" alt="" class="site-header__avatar" />
        <span>Daniel Couttolenc</span>
      </a>
      <nav class="site-header__nav">
        <a href="/work" aria-current={isActive("/work") ? "page" : undefined}>Work</a>
        <a href="/about" aria-current={isActive("/about") ? "page" : undefined}>About</a>
        <a href="/contact" aria-current={isActive("/contact") ? "page" : undefined}>Contact</a>
        <a
          class="site-header__social"
          href="https://instagram.com"
          target="_blank"
          rel="noreferrer"
          aria-label="Instagram"
        >
          <img src="/site/instagram.svg" alt="" width="14" height="14" />
        </a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <a href="mailto:danielcouttolenc@gmail.com">danielcouttolenc@gmail.com</a>
      <a href="/terms" class="site-footer__terms">Terms and Conditions</a>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Season Sans";
    src: url("/fonts/SeasonSans-Regular.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Season Sans";
    src: url("/fonts/SeasonSans-Medium.woff2") format("woff2");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --color-bg: #f7f7f7;
    --color-placeholder: #d9d9d9;
    --color-text: #000;
    --color-text-muted: rgba(0, 0, 0, 0.6);
    --color-text-soft: rgba(0, 0, 0, 0.7);
    --color-hairline: rgba(0, 0, 0, 0.5);
    --font-sans: "Season Sans", -apple-system, "Helvetica Neue", Helvetica, Arial, sans-serif;
    --font-wordmark: "Styrene A", var(--font-sans);
    --header-h: 60px;
    --gutter: 60px;
    --grid-gap: 20px;
    --max-width: 1512px;

    /* Type scale — audited from every screen in the Figma file so sizing/weight/
       tracking stays consistent instead of each page inventing its own values. */
    --fw-regular: 400;
    --fw-medium: 500;

    --fs-caption: 10px;   /* material swatch captions */
    --lh-caption: 15px;

    --fs-meta: 12px;      /* footer, exhibitions table */
    --ls-meta: 0.24px;

    --fs-body: 13px;      /* nav links, descriptions, labels, grid item titles */
    --lh-body: 19px;

    --fs-heading: 16px;   /* page/section titles, Inquire/Submit CTA */
    --ls-heading: 0.32px;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 19px;
    -webkit-font-smoothing: antialiased;
  }

  main {
    display: block;
    padding-top: var(--header-h);
  }

  @media (max-width: 640px) {
    :root {
      --gutter: 20px;
    }
  }

  a {
    color: inherit;
  }

  h1,
  h2,
  h3,
  p,
  ul {
    margin: 0;
  }

  /* Shared type roles — apply these instead of repeating font-size/weight/
     letter-spacing per page, so every screen stays visually consistent. */
  .type-heading {
    font-size: var(--fs-heading);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-heading);
  }

  .type-label {
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    text-transform: uppercase;
  }

  .type-cta {
    display: inline-block;
    font-size: var(--fs-heading);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-heading);
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .type-caption {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    font-weight: var(--fw-regular);
  }

  .type-meta {
    font-size: var(--fs-meta);
    letter-spacing: var(--ls-meta);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    height: var(--header-h);
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--gutter);
    backdrop-filter: blur(3.9px);
    background: rgba(255, 255, 255, 0.3);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: var(--font-wordmark);
    font-size: 14.5px;
    letter-spacing: 0.02em;
    color: var(--color-text);
  }

  .site-header__avatar {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 31px;
  }

  .site-header__nav a {
    font-size: var(--fs-body);
    text-decoration: none;
    color: var(--color-text);
  }

  .site-header__nav a[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .site-header__social {
    display: flex;
    align-items: center;
  }

  .site-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 3rem var(--gutter) 4rem;
    font-size: var(--fs-meta);
    text-align: center;
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer__terms {
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .site-header {
      padding: 0 20px;
    }
    .site-header__brand span {
      display: none;
    }
    .site-header__nav {
      gap: 18px;
    }
  }

</style>
