---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  // Home: la página completa (header + slider + footer) cabe en un solo
  // viewport, sin scroll vertical — ver el script en index.astro que mide
  // header/footer y calcula el alto disponible para el slider.
  noScroll?: boolean;
  // Terms/Privacy: páginas legales que no deben aparecer en buscadores ni
  // pasar autoridad por sus links salientes (pedido explícito de Daniel).
  noindex?: boolean;
}

const SITE_NAME = "Daniel Couttolenc";
const DEFAULT_DESCRIPTION =
  "Daniel Couttolenc is a Mexican designer creating solid wood and cast bronze furniture and objects guided by proportion, geometry, and material exploration.";
const DEFAULT_IMAGE = "/images/Aster table/1.jpg";

const { title, description = DEFAULT_DESCRIPTION, image = DEFAULT_IMAGE, type = "website", noScroll = false, noindex = false } = Astro.props;
const pageTitle =
  title === SITE_NAME || title.includes(SITE_NAME) ? title : `${title} · ${SITE_NAME}`;
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
const canonicalUrl = new URL(path, Astro.site ?? Astro.url.origin).toString();
const absoluteImage = new URL(image, Astro.site ?? Astro.url.origin).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <!-- Recorte propio para el favicon (no el archivo del cursor): el
         isotipo original tiene mucho aire alrededor y a 16px se veía casi
         invisible en la pestaña — pedido de Daniel. -->
    <link rel="icon" type="image/png" href="/site/favicon-isotipo.png" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>document.documentElement.classList.add("js");</script>

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
  </head>
  <body class:list={[{ "home-fit": noScroll }]}>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__brand" href="/">
          <img src="/site/logo-full.svg" alt="Daniel Couttolenc" class="site-header__logo" />
        </a>
        <!-- Solo mobile: el hamburger reemplaza al nav inline (ver CSS) —
             abre/cierra el mismo <nav> de abajo como overlay de pantalla
             completa. En desktop es invisible, no afecta nada. -->
        <button
          type="button"
          class="site-header__toggle"
          id="nav-toggle"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="site-nav"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
        <nav class="site-header__nav" id="site-nav">
          <a href="/work" aria-current={isActive("/work") ? "page" : undefined}>Work</a>
          <a href="/about" aria-current={isActive("/about") ? "page" : undefined}>About</a>
          <a href="/contact" aria-current={isActive("/contact") ? "page" : undefined}>Contact</a>
          <a
            class="site-header__social"
            href="https://www.instagram.com/danielcouttolenc/"
            target="_blank"
            rel="noreferrer"
            aria-label="Instagram"
          >
            <span class="site-header__social-icon" aria-hidden="true"></span>
          </a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      {/* En Contact los correos ya no van en el footer — suben debajo del
         párrafo de intro (ver contact.astro), así que acá solo quedan
         Terms/Privacy en esa página. */}
      {!isActive("/contact") && (
        <a href="mailto:daniel@danielcouttolenc.com">daniel@danielcouttolenc.com</a>
      )}
      <div class="site-footer__legal">
        <a href="/terms" rel="nofollow">Terms and Conditions</a>
        <a href="/privacy" rel="nofollow">Privacy Policy</a>
      </div>
    </footer>

    <div id="custom-cursor" aria-hidden="true">
      <img src="/site/cursor-isotipo.png" alt="" />
    </div>
  </body>
</html>

<script>
  // Cursor personalizado: solo en dispositivos con mouse real (pointer: fine).
  // En touch se deja el comportamiento nativo — el CSS de abajo ya lo cubre.
  const cursorEl = document.getElementById("custom-cursor");
  const hasFinePointer = window.matchMedia("(pointer: fine)").matches;

  if (cursorEl && hasFinePointer) {
    const INTERACTIVE = 'a, button, [role="button"], input, textarea, select, label';

    window.addEventListener(
      "mousemove",
      (e) => {
        cursorEl.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
        cursorEl.classList.remove("is-idle");
      },
      { passive: true }
    );

    // Bug de Chrome: al volver con el botón "atrás" del navegador (la
    // página se restaura desde la bfcache, congelada tal cual quedó), el
    // cursor custom reaparece en su última posición/estado de antes de
    // salir — como el mouse no se movió, no hay un mousemove que lo
    // reubique, y por un instante se ve superpuesto con el cursor nativo
    // (que Chrome sí vuelve a mostrar brevemente en esa transición). Lo
    // ocultamos al restaurar y lo dejamos oculto hasta el próximo
    // mousemove real, que ya lo reposiciona bien y lo revela arriba.
    window.addEventListener("pageshow", () => {
      cursorEl.classList.add("is-idle");
    });

    document.addEventListener("mouseover", (e) => {
      const el = e.target as HTMLElement;
      // Sobre una mitad clickeable del carrusel del home: el cursor se
      // vuelve una flecha ←/→ según la mitad, en vez del isotipo rotado.
      const navZone = el?.closest?.(".carousel__nav") as HTMLElement | null;
      if (navZone) {
        cursorEl.classList.remove("is-hover");
        cursorEl.classList.toggle("is-arrow-left", navZone.classList.contains("carousel__nav--prev"));
        cursorEl.classList.toggle("is-arrow-right", navZone.classList.contains("carousel__nav--next"));
        return;
      }
      if (el?.closest(INTERACTIVE)) {
        cursorEl.classList.add("is-hover");
      }
    });
    document.addEventListener("mouseout", (e) => {
      const el = e.target as HTMLElement;
      if (el?.closest?.(".carousel__nav")) {
        cursorEl.classList.remove("is-arrow-left", "is-arrow-right");
      }
      if (el?.closest(INTERACTIVE)) {
        cursorEl.classList.remove("is-hover");
      }
    });

    document.addEventListener("mouseleave", () => cursorEl.classList.add("is-idle"));
    document.addEventListener("mouseenter", () => cursorEl.classList.remove("is-idle"));
  }
</script>

<script>
  // --- Header durante el rebote superior (ver .is-overscroll en el CSS).
  const siteHeader = document.querySelector(".site-header");
  if (siteHeader) {
    let pending = false;
    window.addEventListener(
      "scroll",
      () => {
        if (pending) return;
        pending = true;
        requestAnimationFrame(() => {
          siteHeader.classList.toggle("is-overscroll", window.scrollY < 0);
          pending = false;
        });
      },
      { passive: true },
    );
  }

  // --- Hamburger menu (solo mobile) — el mismo <nav> del header se abre
  // como overlay de pantalla completa (ver CSS); bloquea el scroll de la
  // página mientras está abierto.
  const navToggle = document.getElementById("nav-toggle");
  const siteNav = document.getElementById("site-nav");

  if (navToggle && siteNav) {
    const closeNav = () => {
      navToggle.classList.remove("is-open");
      navToggle.setAttribute("aria-expanded", "false");
      siteNav.classList.remove("is-open");
      document.body.classList.remove("no-scroll");
    };
    const openNav = () => {
      navToggle.classList.add("is-open");
      navToggle.setAttribute("aria-expanded", "true");
      siteNav.classList.add("is-open");
      document.body.classList.add("no-scroll");
    };

    navToggle.addEventListener("click", () => {
      if (navToggle.classList.contains("is-open")) closeNav();
      else openNav();
    });

    // Al navegar (tap en un link) o con Escape, se cierra — por si la
    // navegación no descarta la página al instante.
    siteNav.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeNav));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeNav();
    });
  }
</script>

<style is:global>
  @font-face {
    font-family: "Season Sans";
    src: url("/fonts/SeasonSans-Regular.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Season Sans";
    src: url("/fonts/SeasonSans-Medium.woff2") format("woff2");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  /* Tipografía del sitio (pedido del diseño) — dos cortes: Thin (el más
     liviano, OS/2 usWeightClass 275) para texto normal, y Light (el más
     grueso de los dos, usWeightClass 300 — reemplaza al "Ultra Light" que
     usábamos antes) para títulos. Registrados en ese orden real (Thin=100,
     Light=200) para que --fw-regular (body) quede con el corte liviano y
     --fw-medium (headings/CTA) con el grueso. Season Sans se deja
     declarada arriba por si hiciera falta un fallback puntual. */
  @font-face {
    font-family: "GT America";
    src: url("/fonts/GTAmerica-Thin.woff2") format("woff2");
    font-weight: 100;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "GT America";
    src: url("/fonts/GTAmerica-Light.woff2") format("woff2");
    font-weight: 200;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --color-bg: #f7f7f7;
    --color-placeholder: #d9d9d9;
    --color-text: #000;
    --color-text-muted: rgba(0, 0, 0, 0.6);
    --color-text-soft: rgba(0, 0, 0, 0.7);
    --color-hairline: rgba(0, 0, 0, 0.5);
    --font-sans: "GT America", "Season Sans", -apple-system, "Helvetica Neue", Helvetica, Arial, sans-serif;
    --font-wordmark: "Styrene A", var(--font-sans);
    --header-h: 60px;
    --gutter: 58px;
    --grid-gap: 35px;
    --max-width: 1512px;

    /* Type scale — audited from every screen in the Figma file so sizing/weight/
       tracking stays consistent instead of each page inventing its own values.
       GT America solo viene en Thin/UltraLight (100/200) — regular usa el
       corte más liviano (Thin) y medium el más pesado de los dos
       (UltraLight), para no perder el corte real pintando bold sintético. */
    --fw-regular: 100;
    --fw-medium: 200;

    /* Toda la escala bajada 1px (pedido del diseño) — proporcional, cada
       tamaño se achica el mismo punto. */
    --fs-caption: 9px;    /* material swatch captions */
    --lh-caption: 14px;

    --fs-meta: 11px;      /* footer, exhibitions table */
    --ls-meta: 0.24px;

    --fs-body: 13px;      /* nav links, descriptions, labels, grid item titles */
    --lh-body: 19px;

    --fs-heading: 15px;   /* page/section titles, Inquire/Submit CTA */
    --ls-heading: 0.32px;
  }

  * {
    box-sizing: border-box;
  }

  /* Los form controls no heredan del sitio por default: el UA les pone su
     propia fuente (Arial/etc.) y, en iOS Safari, el texto de los <button>
     en azul (color de acento del sistema) — de ahí que "Inquire" saliera
     azul en celular. */
  button,
  input,
  select,
  textarea {
    font-family: inherit;
    color: inherit;
  }

  /* Cursor personalizado (ver #custom-cursor + script al final del layout):
     ocultamos el cursor nativo en TODO el sitio, incluyendo la manita que los
     componentes ponen en botones/links via "cursor: pointer" — de ahí el
     !important, es la única forma de reclamar esa propiedad sin tener que
     tocar cada componente que la declara. En touch (sin mouse real) no
     aplica: ahí no hay concepto de cursor que ocultar. */
  html,
  a,
  button,
  [role="button"],
  input,
  textarea,
  select {
    cursor: none !important;
  }

  #custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 52px;
    height: 52px;
    margin: -26px 0 0 -26px;
    pointer-events: none;
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  #custom-cursor img {
    width: 100%;
    height: 100%;
    display: block;
    transition: transform 0.25s ease, opacity 0.15s ease;
  }
  #custom-cursor:not(.is-idle) {
    opacity: 1;
  }
  #custom-cursor.is-hover img {
    transform: rotate(90deg);
  }

  /* Sobre las mitades del carrusel del home: el isotipo se oculta y sale
     un chevron ←/→ (mismos trazos que las flechas viejas del carrusel). */
  #custom-cursor::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 14px;
    border-top: 2px solid var(--color-text);
    border-right: 2px solid var(--color-text);
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  #custom-cursor.is-arrow-left img,
  #custom-cursor.is-arrow-right img {
    opacity: 0;
  }
  #custom-cursor.is-arrow-left::after {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(-135deg);
  }
  #custom-cursor.is-arrow-right::after {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    #custom-cursor img {
      transition: none;
    }
  }
  @media (pointer: coarse) {
    html,
    a,
    button,
    [role="button"],
    input,
    textarea,
    select {
      cursor: auto !important;
    }
    #custom-cursor {
      display: none;
    }
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  /* Color de "relleno" que se asoma un instante en el rebote elástico del
     scroll (Safari/iOS) cuando el usuario pasa de largo el tope/fin de la
     página — el body no cubre ese hueco, lo cubre el html de atrás.
     Pedido del diseño: 834633 en vez del blanco default. */
  html {
    background: #834633;
  }

  body {
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-weight: var(--fw-regular);
    font-size: 13px;
    line-height: 19px;
    -webkit-font-smoothing: antialiased;
  }

  main {
    display: block;
    padding-top: var(--header-h);
  }

  @media (max-width: 640px) {
    :root {
      --gutter: 20px;
    }
  }

  a {
    color: inherit;
  }

  h1,
  h2,
  h3,
  p,
  ul {
    margin: 0;
  }

  /* Shared type roles — apply these instead of repeating font-size/weight/
     letter-spacing per page, so every screen stays visually consistent. */
  .type-heading {
    font-size: var(--fs-heading);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-heading);
  }

  .type-label {
    font-size: var(--fs-body);
    /* Antes fw-medium — pedido del diseño: Dimensions/Material/Lead time
       ya no llevan más peso que el body, la jerarquía la dan las
       mayúsculas + las líneas, no el bold. */
    font-weight: var(--fw-regular);
    text-transform: uppercase;
  }

  .type-cta {
    display: inline-block;
    font-size: var(--fs-heading);
    /* Inquire/Submit van con el corte grueso (Thin, --fw-medium) — mismo
       peso que los títulos, para que el CTA se note como tal. */
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-heading);
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .type-caption {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    font-weight: var(--fw-regular);
  }

  .type-meta {
    font-size: var(--fs-meta);
    letter-spacing: var(--ls-meta);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Compartido por el hamburger menu de abajo y los modales (lightbox,
     inquire) definidos por página — bloquea el scroll del body detrás de
     cualquier overlay de pantalla completa. */
  body.no-scroll {
    overflow: hidden;
  }

  /* Blur del fondo cuando hay un modal abierto (lightbox / Inquire). Se
     aplica con filter sobre el contenido de la página en vez de
     backdrop-filter sobre el modal: Safari ignora backdrop-filter en varios
     casos (p. ej. con "Reducir transparencia" activado en macOS/iOS) y el
     blur no se veía. filter funciona igual en todos los navegadores. Los
     modales (hermanos de .pieza/.coleccion) quedan nítidos. */
  .site-header,
  .site-footer,
  .pieza > *,
  .coleccion > * {
    transition: filter 0.25s ease;
  }
  body.modal-open .site-header,
  body.modal-open .site-footer,
  body.modal-open .pieza > *,
  body.modal-open .coleccion > * {
    filter: blur(24px);
  }

  /* --- Animaciones de entrada (pedido de los diseñadores, referencias:
     ROA, Zara, cosmos.so) — tres variantes compartidas por el sitio.
     "both" como fill-mode: el elemento arranca en el estado "from" desde
     antes de que la animación corra (sin flash del estado final) y se
     queda en "to" al terminar. Además de "both", cada clase declara
     opacity/transform/filter directo (no solo dentro del @keyframes) —
     así el estado inicial (oculto) no depende de que el navegador ya
     haya resuelto la animación a tiempo para el primer paint; es la
     causa típica del parpadeo "aparece visible y luego se esconde".
     Todas respetan prefers-reduced-motion. */
  @keyframes anim-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes anim-fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes anim-zoom-blur-in {
    from {
      opacity: 0;
      transform: scale(1.03);
      filter: blur(5px);
    }
    to {
      opacity: 1;
      transform: scale(1);
      filter: blur(0);
    }
  }

  .anim-fade-in {
    opacity: 0;
    animation: anim-fade-in 0.65s ease-out both;
  }
  .anim-fade-up {
    opacity: 0;
    transform: translateY(12px);
    animation: anim-fade-up 0.6s ease-out both;
  }
  .anim-zoom-blur-in {
    opacity: 0;
    transform: scale(1.03);
    filter: blur(5px);
    animation: anim-zoom-blur-in 0.85s ease-out both;
  }

  @media (prefers-reduced-motion: reduce) {
    .anim-fade-in,
    .anim-fade-up,
    .anim-zoom-blur-in {
      opacity: 1;
      transform: none;
      filter: none;
      animation: none !important;
    }
  }
</style>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    height: var(--header-h);
    z-index: 50;
    /* Safari (sobre todo iOS y macOS < 15.4) necesita el prefijo -webkit-
       para aplicar backdrop-filter — sin él, la propiedad se ignora en
       silencio y solo se ve el fondo translúcido, sin blur. */
    -webkit-backdrop-filter: blur(3.9px);
    backdrop-filter: blur(3.9px);
    background: rgba(255, 255, 255, 0.3);
  }

  /* Rebote elástico hacia arriba (scrollY < 0): el header fijo es
     translúcido con blur, así que el color de relleno de atrás se veía
     difuminado y lavado a través de él. Mientras dura el rebote se vuelve
     transparente y sin blur para que el color se vea sólido. */
  .site-header.is-overscroll {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    background: transparent;
  }

  .site-header__inner {
    max-width: var(--max-width);
    height: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--gutter);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--color-text);
  }

  .site-header__logo {
    display: block;
    height: 28px;
    width: auto;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 31px;
  }

  .site-header__nav a {
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    text-decoration: none;
    /* Pedido de Daniel: intercambiar los colores fijo/hover — antes negro
       fijo y gris en hover, ahora gris fijo (igual que Inquire) y negro en
       hover. */
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  .site-header__nav a:hover {
    color: var(--color-text);
  }

  /* Sección activa en negro — pedido nuevo (antes no tenía tratamiento
     propio: quedaba igual que el resto, gris, hasta hacerle hover). */
  .site-header__nav a[aria-current="page"] {
    color: var(--color-text);
  }

  .site-header__social {
    display: flex;
    align-items: center;
  }

  /* Antes era un <img src="instagram.svg">: un archivo externo no puede
     heredar el color del link, por eso el hover no le hacía nada. Con
     mask-image + background-color:currentColor el ícono sí sigue el color
     (y su transition) del <a> que lo contiene, igual que el texto. */
  .site-header__social-icon {
    display: block;
    width: 14px;
    height: 14px;
    background-color: currentColor;
    -webkit-mask: url("/site/instagram.svg") center / contain no-repeat;
    mask: url("/site/instagram.svg") center / contain no-repeat;
  }

  /* Hamburger — invisible en desktop, el nav inline de arriba se queda
     igual que siempre. */
  .site-header__toggle {
    display: none;
  }

  .site-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 3rem var(--gutter) 4rem;
    font-size: var(--fs-meta);
    text-align: center;
  }

  .site-footer a {
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-footer a:hover {
    color: var(--color-text-muted);
  }

  .site-footer__legal {
    display: flex;
    gap: 16px;
    color: var(--color-text-muted);
  }

  /* Ya arrancan grises (heredado de .site-footer__legal) — el hover
