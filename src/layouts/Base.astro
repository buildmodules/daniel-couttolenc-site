---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}

const SITE_NAME = "Daniel Couttolenc";
const DEFAULT_DESCRIPTION =
  "Daniel Couttolenc is a Mexican designer creating solid wood and cast bronze furniture and objects guided by proportion, geometry, and material exploration.";
const DEFAULT_IMAGE = "/images/Aster table/1.jpg";

const { title, description = DEFAULT_DESCRIPTION, image = DEFAULT_IMAGE, type = "website" } = Astro.props;
const pageTitle =
  title === SITE_NAME || title.includes(SITE_NAME) ? title : `${title} · ${SITE_NAME}`;
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
const canonicalUrl = new URL(path, Astro.site ?? Astro.url.origin).toString();
const absoluteImage = new URL(image, Astro.site ?? Astro.url.origin).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/site/cursor-isotipo.png" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__brand" href="/">
          <img src="/site/logo-full.svg" alt="Daniel Couttolenc" class="site-header__logo" />
        </a>
        <!-- Solo mobile: el hamburger reemplaza al nav inline (ver CSS) —
             abre/cierra el mismo <nav> de abajo como overlay de pantalla
             completa. En desktop es invisible, no afecta nada. -->
        <button
          type="button"
          class="site-header__toggle"
          id="nav-toggle"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="site-nav"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
        <nav class="site-header__nav" id="site-nav">
          <a href="/work" aria-current={isActive("/work") ? "page" : undefined}>Work</a>
          <a href="/about" aria-current={isActive("/about") ? "page" : undefined}>About</a>
          <a href="/contact" aria-current={isActive("/contact") ? "page" : undefined}>Contact</a>
          <a
            class="site-header__social"
            href="https://www.instagram.com/danielcouttolenc/"
            target="_blank"
            rel="noreferrer"
            aria-label="Instagram"
          >
            <img src="/site/instagram.svg" alt="" width="14" height="14" />
          </a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      {isActive("/contact") ? (
        <>
          <a href="mailto:danielcouttolenc@gmail.com">danielcouttolenc@gmail.com</a>
          <a href="mailto:studio@danielcouttolenc.com">studio@danielcouttolenc.com</a>
        </>
      ) : (
        <a href="mailto:danielcouttolenc@gmail.com">danielcouttolenc@gmail.com</a>
      )}
      <a href="/terms" class="site-footer__terms">Terms and Conditions</a>
    </footer>

    <div id="custom-cursor" aria-hidden="true">
      <img src="/site/cursor-isotipo.png" alt="" />
    </div>
  </body>
</html>

<script>
  // Cursor personalizado: solo en dispositivos con mouse real (pointer: fine).
  // En touch se deja el comportamiento nativo — el CSS de abajo ya lo cubre.
  const cursorEl = document.getElementById("custom-cursor");
  const hasFinePointer = window.matchMedia("(pointer: fine)").matches;

  if (cursorEl && hasFinePointer) {
    const INTERACTIVE = 'a, button, [role="button"], input, textarea, select, label';

    window.addEventListener(
      "mousemove",
      (e) => {
        cursorEl.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
      },
      { passive: true }
    );

    document.addEventListener("mouseover", (e) => {
      const el = e.target as HTMLElement;
      // Sobre una mitad clickeable del carrusel del home: el cursor se
      // vuelve una flecha ←/→ según la mitad, en vez del isotipo rotado.
      const navZone = el?.closest?.(".carousel__nav") as HTMLElement | null;
      if (navZone) {
        cursorEl.classList.remove("is-hover");
        cursorEl.classList.toggle("is-arrow-left", navZone.classList.contains("carousel__nav--prev"));
        cursorEl.classList.toggle("is-arrow-right", navZone.classList.contains("carousel__nav--next"));
        return;
      }
      if (el?.closest(INTERACTIVE)) {
        cursorEl.classList.add("is-hover");
      }
    });
    document.addEventListener("mouseout", (e) => {
      const el = e.target as HTMLElement;
      if (el?.closest?.(".carousel__nav")) {
        cursorEl.classList.remove("is-arrow-left", "is-arrow-right");
      }
      if (el?.closest(INTERACTIVE)) {
        cursorEl.classList.remove("is-hover");
      }
    });

    document.addEventListener("mouseleave", () => cursorEl.classList.add("is-idle"));
    document.addEventListener("mouseenter", () => cursorEl.classList.remove("is-idle"));
  }
</script>

<script>
  // --- Hamburger menu (solo mobile) — el mismo <nav> del header se abre
  // como overlay de pantalla completa (ver CSS); bloquea el scroll de la
  // página mientras está abierto.
  const navToggle = document.getElementById("nav-toggle");
  const siteNav = document.getElementById("site-nav");

  if (navToggle && siteNav) {
    const closeNav = () => {
      navToggle.classList.remove("is-open");
      navToggle.setAttribute("aria-expanded", "false");
      siteNav.classList.remove("is-open");
      document.body.classList.remove("no-scroll");
    };
    const openNav = () => {
      navToggle.classList.add("is-open");
      navToggle.setAttribute("aria-expanded", "true");
      siteNav.classList.add("is-open");
      document.body.classList.add("no-scroll");
    };

    navToggle.addEventListener("click", () => {
      if (navToggle.classList.contains("is-open")) closeNav();
      else openNav();
    });

    // Al navegar (tap en un link) o con Escape, se cierra — por si la
    // navegación no descarta la página al instante.
    siteNav.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeNav));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeNav();
    });
  }
</script>

<style is:global>
  @font-face {
    font-family: "Season Sans";
    src: url("/fonts/SeasonSans-Regular.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Season Sans";
    src: url("/fonts/SeasonSans-Medium.woff2") format("woff2");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --color-bg: #f7f7f7;
    --color-placeholder: #d9d9d9;
    --color-text: #000;
    --color-text-muted: rgba(0, 0, 0, 0.6);
    --color-text-soft: rgba(0, 0, 0, 0.7);
    --color-hairline: rgba(0, 0, 0, 0.5);
    --font-sans: "Season Sans", -apple-system, "Helvetica Neue", Helvetica, Arial, sans-serif;
    --font-wordmark: "Styrene A", var(--font-sans);
    --header-h: 60px;
    --gutter: 58px;
    --grid-gap: 20px;
    --max-width: 1512px;

    /* Type scale — audited from every screen in the Figma file so sizing/weight/
       tracking stays consistent instead of each page inventing its own values. */
    --fw-regular: 400;
    --fw-medium: 500;

    --fs-caption: 10px;   /* material swatch captions */
    --lh-caption: 15px;

    --fs-meta: 12px;      /* footer, exhibitions table */
    --ls-meta: 0.24px;

    --fs-body: 14px;      /* nav links, descriptions, labels, grid item titles */
    --lh-body: 20px;

    --fs-heading: 16px;   /* page/section titles, Inquire/Submit CTA */
    --ls-heading: 0.32px;
  }

  * {
    box-sizing: border-box;
  }

  /* Los form controls no heredan la tipografía del sitio por default (el UA
     les pone Arial/etc.) — en varios sitios los <button> "Inquire" salían
     con la fuente equivocada. */
  button,
  input,
  select,
  textarea {
    font-family: inherit;
  }

  /* Cursor personalizado (ver #custom-cursor + script al final del layout):
     ocultamos el cursor nativo en TODO el sitio, incluyendo la manita que los
     componentes ponen en botones/links via "cursor: pointer" — de ahí el
     !important, es la única forma de reclamar esa propiedad sin tener que
     tocar cada componente que la declara. En touch (sin mouse real) no
     aplica: ahí no hay concepto de cursor que ocultar. */
  html,
  a,
  button,
  [role="button"],
  input,
  textarea,
  select {
    cursor: none !important;
  }

  #custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 52px;
    height: 52px;
    margin: -26px 0 0 -26px;
    pointer-events: none;
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  #custom-cursor img {
    width: 100%;
    height: 100%;
    display: block;
    transition: transform 0.25s ease, opacity 0.15s ease;
  }
  #custom-cursor:not(.is-idle) {
    opacity: 1;
  }
  #custom-cursor.is-hover img {
    transform: rotate(90deg);
  }

  /* Sobre las mitades del carrusel del home: el isotipo se oculta y sale
     un chevron ←/→ (mismos trazos que las flechas viejas del carrusel). */
  #custom-cursor::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 14px;
    border-top: 2px solid var(--color-text);
    border-right: 2px solid var(--color-text);
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  #custom-cursor.is-arrow-left img,
  #custom-cursor.is-arrow-right img {
    opacity: 0;
  }
  #custom-cursor.is-arrow-left::after {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(-135deg);
  }
  #custom-cursor.is-arrow-right::after {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    #custom-cursor img {
      transition: none;
    }
  }
  @media (pointer: coarse) {
    html,
    a,
    button,
    [role="button"],
    input,
    textarea,
    select {
      cursor: auto !important;
    }
    #custom-cursor {
      display: none;
    }
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 20px;
    -webkit-font-smoothing: antialiased;
  }

  main {
    display: block;
    padding-top: var(--header-h);
  }

  @media (max-width: 640px) {
    :root {
      --gutter: 20px;
    }
  }

  a {
    color: inherit;
  }

  h1,
  h2,
  h3,
  p,
  ul {
    margin: 0;
  }

  /* Shared type roles — apply these instead of repeating font-size/weight/
     letter-spacing per page, so every screen stays visually consistent. */
  .type-heading {
    font-size: var(--fs-heading);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-heading);
  }

  .type-label {
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    text-transform: uppercase;
  }

  .type-cta {
    display: inline-block;
    font-size: var(--fs-heading);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-heading);
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .type-caption {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    font-weight: var(--fw-regular);
  }

  .type-meta {
    font-size: var(--fs-meta);
    letter-spacing: var(--ls-meta);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Compartido por el hamburger menu de abajo y los modales (lightbox,
     inquire) definidos por página — bloquea el scroll del body detrás de
     cualquier overlay de pantalla completa. */
  body.no-scroll {
    overflow: hidden;
  }
</style>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    height: var(--header-h);
    z-index: 50;
    backdrop-filter: blur(3.9px);
    background: rgba(255, 255, 255, 0.3);
  }

  .site-header__inner {
    max-width: var(--max-width);
    height: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--gutter);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--color-text);
  }

  .site-header__logo {
    display: block;
    height: 28px;
    width: auto;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 31px;
  }

  .site-header__nav a {
    font-size: var(--fs-body);
    text-decoration: none;
    color: var(--color-text);
    transition: opacity 0.2s ease;
  }

  .site-header__nav a:hover {
    color: var(--color-text-muted);
  }

  /* El activo ya no se subraya — queda con el gris de hover, fijo. */
  .site-header__nav a[aria-current="page"] {
    color: var(--color-text-muted);
  }

  .site-header__social {
    display: flex;
    align-items: center;
  }

  /* Hamburger — invisible en desktop, el nav inline de arriba se queda
     igual que siempre. */
  .site-header__toggle {
    display: none;
  }

  .site-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 3rem var(--gutter) 4rem;
    font-size: var(--fs-meta);
    text-align: center;
  }

  .site-footer a {
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-footer a:hover {
    color: var(--color-text-muted);
  }

  .site-footer__terms {
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    /* El toggle reemplaza al nav inline — mismo breakpoint que el resto
       del sitio (WorkGrid, pieza/colección, about, contact). */
    .site-header__toggle {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 5px;
      width: 24px;
      height: 24px;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      appearance: none;
      outline: none;
      /* Por encima del overlay del nav (hermano, más adelante en el DOM)
         para seguir siendo clickeable/visible con el nav abierto. */
      position: relative;
      z-index: 2;
      /* 30% más grande (pedido del diseño) — escala también la animación
         a X de los spans hijos, sin recalcular sus translate. */
      transform: scale(1.3);
    }
    .site-header__toggle span {
      display: block;
      width: 100%;
      height: 1px;
      background: var(--color-text);
      transition: transform 0.25s ease, opacity 0.2s ease;
    }
    /* Animación a X cuando el nav está abierto. */
    .site-header__toggle.is-open span:first-child {
      transform: translateY(6px) rotate(45deg);
    }
    .site-header__toggle.is-open span:nth-child(2) {
      opacity: 0;
    }
    .site-header__toggle.is-open span:last-child {
      transform: translateY(-6px) rotate(-45deg);
    }

    /* El logo también queda por encima del overlay (mismo motivo que el
       toggle) — sigue visible mientras el menú está abierto. */
    .site-header__brand {
      position: relative;
      z-index: 2;
    }

    /* El nav inline se oculta — solo existe como el overlay de abajo. */
    .site-header__nav {
      display: none;
    }
    .site-header__nav.is-open {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100dvh;
      margin: 0;
      background: #fff;
      text-align: center;
      gap: 48px;
    }
    /* Links del menú desplegado al doble de tamaño (pedido del diseño). */
    .site-header__nav.is-open a {
      font-size: calc(var(--fs-heading) * 2);
    }
    .site-header__nav.is-open .site-header__social img {
      width: 30px;
      height: 30px;
    }
    /* Logo 30% más grande en mobile (28 → 36). */
    .site-header__logo {
      height: 36px;
    }
  }

  @media (max-width: 640px) {
    .site-header__inner {
      padding: 0 16px;
    }
    .site-header__logo {
      height: 29px;
    }
    .site-header__nav {
      gap: 10px;
    }
  }

  @media (max-width: 360px) {
    .site-header__inner {
      padding: 0 12px;
    }
    .site-header__logo {
      height: 20px;
    }
    .site-header__nav {
      gap: 6px;
    }
    .site-header__nav a {
      font-size: 12px;
    }
  }

</style>
