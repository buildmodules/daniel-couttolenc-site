---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const exhibiciones = (await getCollection("exhibiciones")).sort((a, b) => {
  const oa = a.data.orden ?? 999;
  const ob = b.data.orden ?? 999;
  if (oa !== ob) return oa - ob;
  return b.data.anio.localeCompare(a.data.anio);
});
---
<Base
  title="About"
  description="Daniel Couttolenc is a Mexican designer whose work begins with curiosity, guided by proportion, geometry, and material exploration."
  image="/site/about-portrait.png"
>
  <section class="about">
    <img class="about__portrait" id="about-portrait" src="/site/about-portrait.png" alt="Daniel Couttolenc" />

    <div class="about__content" id="about-content">
      <div class="about__intro" id="about-intro">
        <h1 class="type-heading">About</h1>
        <p>
          Daniel Couttolenc is a Mexican designer whose work begins with curiosity.
        </p>
        <p>
          Drawn to design from an early age, he was also interested in questions of
          spirituality, meaning, and inner balance. The study of sacred geometry
          eventually revealed a connection between them.
        </p>
        <p>
          Each piece begins as an impression—something observed, experienced, or felt.
          Guided by intuition and refined through proportion, geometry, and material
          exploration, these impressions gradually take shape as objects. Created as
          pieces of harmony, they invite a sense of presence and connection.
        </p>
      </div>

      <h2 class="type-heading">Exhibitions</h2>
      <ul class="about__exhibitions" id="exhibitions-list">
        {exhibiciones.map((e) => (
          e.data.foto ? (
            <li data-foto={e.data.foto}>
              <!-- Solo mobile: el botón reemplaza el hover-preview de
                   desktop por un dropdown — tap para ver la foto debajo de
                   esta fila. En desktop es invisible (display:contents),
                   el li se ve exactamente igual que antes. -->
              <button type="button" class="about__exhibition-row" aria-expanded="false">
                <span class="about__year">{e.data.anio}</span>
                <span class="about__exhibition-name">{e.data.nombre}</span>
                <span class="about__arrow" aria-hidden="true">
                  <svg width="9" height="9" viewBox="0 0 9 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4.15625 3.48008e-07L4.15625 8" stroke="currentColor" stroke-width="0.5" />
                    <path d="M8.137 3.98075L4.15625 7.9615L0.1755 3.98075" stroke="currentColor" stroke-width="0.5" />
                  </svg>
                </span>
              </button>
              <div class="about__exhibition-panel">
                <img src={e.data.foto} alt={e.data.nombre} loading="lazy" />
              </div>
            </li>
          ) : (
            <li data-foto="">
              <span class="about__year">{e.data.anio}</span>
              <span class="about__exhibition-name">{e.data.nombre}</span>
            </li>
          )
        ))}
      </ul>
    </div>
  </section>

  <div class="about__float" id="exhibitions-float" aria-hidden="true">
    <img id="exhibitions-float-img" alt="" />
  </div>
</Base>

<script>
  const list = document.getElementById("exhibitions-list");
  const float = document.getElementById("exhibitions-float");
  const floatImg = document.getElementById("exhibitions-float-img") as HTMLImageElement | null;

  if (list && float && floatImg) {
    const items = Array.from(list.querySelectorAll<HTMLLIElement>("li[data-foto]"));
    const OFFSET_X = 28;
    const OFFSET_Y = -80;

    const positionFloat = (clientX: number, clientY: number) => {
      const rect = float.getBoundingClientRect();
      let x = clientX + OFFSET_X;
      let y = clientY + OFFSET_Y;
      x = Math.min(x, window.innerWidth - rect.width - 16);
      y = Math.max(y, 16);
      float.style.transform = `translate(${x}px, ${y}px)`;
    };

    items.forEach((item) => {
      const foto = item.dataset.foto;

      item.addEventListener("mouseenter", (e) => {
        if (!foto) {
          // Sin foto asignada (falta el material) — ocultamos el preview en
          // vez de dejar pegada la última foto real que se mostró, que se
          // ve como si varias filas compartieran la misma imagen.
          float.classList.remove("is-visible");
          return;
        }
        floatImg.src = foto;
        float.classList.add("is-visible");
        positionFloat((e as MouseEvent).clientX, (e as MouseEvent).clientY);
      });
    });

    list.addEventListener("mousemove", (e) => {
      positionFloat(e.clientX, e.clientY);
    });

    list.addEventListener("mouseleave", () => {
      float.classList.remove("is-visible");
    });
  }
</script>

<script>
  // --- Mobile: Exhibitions como dropdown — tap en la fila muestra la foto
  // debajo de esa misma fila (en vez del hover-preview flotante, que en
  // mobile no tiene sentido). Cada fila es independiente — no se cierran
  // las demás al abrir una.
  const exhibitionRows = document.querySelectorAll<HTMLButtonElement>(".about__exhibition-row");

  exhibitionRows.forEach((btn) => {
    const panel = btn.nextElementSibling as HTMLElement | null;
    const img = panel?.querySelector("img");
    if (!panel) return;

    const setOpenHeight = () => {
      panel.style.maxHeight = `${panel.scrollHeight}px`;
    };

    btn.addEventListener("click", () => {
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      if (isOpen) {
        btn.setAttribute("aria-expanded", "false");
        panel.style.maxHeight = "0px";
      } else {
        btn.setAttribute("aria-expanded", "true");
        // Si la foto ya cargó, el alto real está disponible ya; si no,
        // recalculamos cuando termine de cargar (si no, el alto se mide
        // en 0 y el dropdown no se ve).
        if (img && !(img as HTMLImageElement).complete) {
          img.addEventListener("load", setOpenHeight, { once: true });
        }
        setOpenHeight();
      }
    });
  });
</script>

<script>
  // Alinea el bottom de about__intro con el bottom de la foto (solo desktop,
  // donde la foto va sticky junto a la columna de texto). La altura de ambas
  // es fluida (%), así que se recalcula con ResizeObserver en vez de un valor fijo.
  const portrait = document.getElementById("about-portrait") as HTMLImageElement | null;
  const content = document.getElementById("about-content");
  const intro = document.getElementById("about-intro");

  if (portrait && content && intro) {
    const isDesktop = () => window.matchMedia("(min-width: 901px)").matches;

    const align = () => {
      if (!isDesktop()) {
        content.style.paddingTop = "";
        return;
      }
      const pad = Math.max(0, portrait.offsetHeight - intro.offsetHeight);
      content.style.paddingTop = `${pad}px`;
    };

    const ro = new ResizeObserver(align);
    ro.observe(portrait);
    ro.observe(intro);
    window.addEventListener("resize", align);

    if (portrait.complete) {
      align();
    } else {
      portrait.addEventListener("load", align, { once: true });
    }
  }
</script>

<style>
  /* En Figma, la pantalla de About usa un fondo #CBCBCB propio, distinto del
     #F7F7F7 global del resto del sitio. */
  :global(body) {
    background: #cbcbcb;
  }

  .about {
    display: grid;
    /* La columna de la foto ocupa el 45% del container. */
    grid-template-columns: 45% 1fr;
    align-items: start;
    gap: var(--grid-gap);
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 40px var(--gutter) 4rem;
  }
  .about__portrait {
    /* Pedido de Juanjo: la foto llena el alto del viewport (como en
       piezas/colecciones) para que al entrar solo se vea la foto + el
       intro — Exhibitions queda abajo, fuera de la vista inicial. El -3rem
       deja una línea de fondo gris visible debajo de la foto antes de
       pasar a Exhibitions, en vez de llegar a ras del borde del viewport.
       Con el ancho ahora fijo a la columna (50%), object-fit: cover
       recorta lo que sobre en vez de distorsionar. */
    width: 100%;
    height: calc(100vh - var(--header-h) - 40px - 3rem);
    object-fit: cover;
    display: block;
    position: sticky;
    top: calc(var(--header-h) + 40px);
  }
  .about__intro {
    max-width: 30rem;
  }
  .about h1 {
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .about p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    margin-bottom: 1em;
  }
  .about h2 {
    text-transform: uppercase;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
  .about__exhibitions {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .about__exhibitions li {
    display: flex;
    gap: var(--grid-gap);
    padding: 9px 0;
    border-top: 1px solid var(--color-hairline);
    font-size: var(--fs-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    /* Sin cursor: default/pointer aquí — el sitio usa un cursor propio
       (cursor: none global + elemento JS); un cursor explícito en este li
       gana sobre esa herencia y muestra la flecha/manita nativa. */
  }
  .about__exhibitions li:last-child {
    border-bottom: 1px solid var(--color-hairline);
  }
  .about__year {
    flex: 0 0 40px;
  }

  /* El botón es invisible en desktop (display:contents) — el li se ve
     exactamente igual que antes, año + nombre en fila. El dropdown
     (flecha + panel de foto) es un componente solo-mobile. */
  .about__exhibition-row {
    display: contents;
  }
  .about__arrow {
    display: none;
  }
  .about__exhibition-panel {
    display: none;
  }

  .about__float {
    position: fixed;
    top: 0;
    left: 0;
    height: 25vh;
    width: auto;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
    z-index: 40;
    will-change: transform;
  }
  .about__float.is-visible {
    opacity: 1;
  }
  .about__float img {
    height: 100%;
    width: auto;
    display: block;
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
      /* Antes 72px — igual que /work y /contact ahora: consistente en
         todo el sitio, el offset del header fijo ya lo da
         main{padding-top:var(--header-h)} en Base.astro. */
      padding-top: 24px;
      /* 50% más que el padding-top de arriba (24px) — el H1 debajo trae su
         propio leading, así que a valores iguales el espacio de abajo se
         percibía más chico. Con 36px la foto queda encuadrada pareja
         arriba y abajo a simple vista. */
      row-gap: 36px;
      /* 35% menos que el padding-bottom de desktop (4rem). */
      padding-bottom: 2.6rem;
    }
    .about__portrait {
      position: static;
      /* Pedido del diseño: la foto ocupa 75% del ancho, centrada — no
         100vw como antes. height:auto = alto natural según el ratio real
         del archivo, tampoco se recorta aquí. 10% más chica que ese 75%
         (67.5%). */
      width: 67.5%;
      height: auto;
      margin: 0 auto;
      padding-top: 10%;
      padding-bottom: 10%;
    }
    .about__float {
      display: none;
    }

    /* Exhibitions como dropdown — la fila entera es el botón (tap-target
       grande), año/nombre heredan el estilo de texto que antes vivía en el
       li (ver .about__exhibitions li arriba). */
    /* Sin foto: sigue siendo la fila simple año + nombre (flex, sin botón
       ni dropdown — no hay nada que expandir). */
    .about__exhibitions li[data-foto=""] {
      padding: 9px 0;
    }
    /* Con foto: el li ahora tiene dos hijos que deben apilarse (el botón
       — que es su propia fila flex — arriba, el panel de la foto debajo),
       no ir lado a lado como el flex row de desktop. */
    .about__exhibitions li:not([data-foto=""]) {
      display: block;
      padding: 0;
    }
    .about__exhibition-row {
      display: flex;
      align-items: center;
      width: 100%;
      gap: var(--grid-gap);
      padding: 9px 0;
      background: none;
      border: none;
      font: inherit;
      color: inherit;
      text-transform: inherit;
      letter-spacing: inherit;
      text-align: left;
      cursor: pointer;
      appearance: none;
      outline: none;
    }
    .about__exhibition-row:focus-visible {
      outline: 1px solid var(--color-hairline);
      outline-offset: 4px;
    }
    /* Del diseño: el nombre no ocupa todo el ancho disponible de la fila —
       envuelve antes, en una columna angosta (año | nombre | flecha, no
       año | nombre-larguísimo | flecha). */
    .about__exhibition-name {
      max-width: 170px;
    }
    .about__arrow {
      display: block;
      flex-shrink: 0;
      margin-left: auto;
      transition: transform 0.25s ease;
    }
    .about__exhibition-row[aria-expanded="true"] .about__arrow {
      transform: rotate(180deg);
    }
    .about__exhibition-panel {
      display: block;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }
    .about__exhibition-panel img {
      /* Del diseño: 75% del ancho, alineada a la izquierda (mismo borde
         que año/nombre) — no edge-to-edge ni centrada. */
      width: 75%;
      display: block;
      margin-bottom: 16px;
    }
  }
</style>
