---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const colecciones = await getCollection("colecciones");
  return colecciones.map((coleccion) => ({
    params: { slug: coleccion.data.slug },
    props: { coleccion },
  }));
}

const { coleccion } = Astro.props as any;
const { Content } = await render(coleccion);
const { titulo, galeria, portada, badge, creditosFotos, metaTitle, metaDescription, ogImage } = coleccion.data;
const imagenes: string[] = galeria ?? (portada ? [portada] : []);
// Ver el comentario equivalente en pieces/[slug].astro.
const creditosPorFoto = new Map((creditosFotos ?? []).map((c: any) => [c.imagen, c.texto]));
---
<Base
  title={metaTitle || titulo}
  description={metaDescription}
  image={ogImage || portada}
>
  <article class="coleccion">
    <a class="coleccion__close" href="/work" aria-label="Cerrar">
      <span></span>
      <span></span>
    </a>

    <div class="coleccion__galeria">
      {imagenes.map((img: string, i: number) => (
        <button
          type="button"
          class:list={["coleccion__foto", creditosPorFoto.has(img) && "coleccion__foto--con-credito"]}
          data-index={i}
        >
          <img src={img} alt={titulo} loading={i === 0 ? "eager" : "lazy"} />
          {creditosPorFoto.has(img) && (
            <span class="coleccion__foto-credito">{creditosPorFoto.get(img)}</span>
          )}
        </button>
      ))}
    </div>

    <div class="coleccion__info-sticky">
      <div class="coleccion__info">
        <h1 class="type-heading">{titulo}</h1>
        {badge && <p class="coleccion__badge type-label">{badge}</p>}
        <div class="coleccion__descripcion"><Content /></div>

        <a
          class="inquire type-cta"
          href={`/contact?subject=${encodeURIComponent(`I'd like to know more about ${titulo}.`)}`}
        >
          Inquire
        </a>
      </div>
    </div>
  </article>

  <!-- Lightbox de galería -->
  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button type="button" class="lightbox__close" id="lightbox-close" aria-label="Cerrar">
      <span></span>
      <span></span>
    </button>
    <button type="button" class="lightbox__arrow lightbox__arrow--prev" id="lightbox-prev" aria-label="Foto anterior">
      <span></span>
    </button>
    <div class="lightbox__stage">
      <img id="lightbox-img" src="" alt={titulo} />
    </div>
    <button type="button" class="lightbox__arrow lightbox__arrow--next" id="lightbox-next" aria-label="Foto siguiente">
      <span></span>
    </button>
  </div>
</Base>

<script>
  // --- Lightbox de galería ---
  const photos = Array.from(document.querySelectorAll<HTMLButtonElement>(".coleccion__foto"));
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement | null;
  const lightboxClose = document.getElementById("lightbox-close");
  const lightboxPrev = document.getElementById("lightbox-prev");
  const lightboxNext = document.getElementById("lightbox-next");
  const sources = photos.map((btn) => btn.querySelector("img")?.getAttribute("src") ?? "");
  let lightboxIndex = 0;

  const openLightbox = (index: number) => {
    if (!lightbox || !lightboxImg || sources.length === 0) return;
    lightboxIndex = (index + sources.length) % sources.length;
    lightboxImg.src = sources[lightboxIndex];
    lightbox.classList.add("is-visible");
    lightbox.setAttribute("aria-hidden", "false");
    document.body.classList.add("no-scroll");
  };

  const closeLightbox = () => {
    if (!lightbox) return;
    lightbox.classList.remove("is-visible");
    lightbox.setAttribute("aria-hidden", "true");
    document.body.classList.remove("no-scroll");
  };

  const showLightbox = (delta: number) => openLightbox(lightboxIndex + delta);

  photos.forEach((btn) => {
    btn.addEventListener("click", () => openLightbox(Number(btn.dataset.index)));
  });
  lightboxClose?.addEventListener("click", closeLightbox);
  lightboxPrev?.addEventListener("click", () => showLightbox(-1));
  lightboxNext?.addEventListener("click", () => showLightbox(1));
  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLightbox();
    if (lightbox?.classList.contains("is-visible")) {
      if (e.key === "ArrowLeft") showLightbox(-1);
      if (e.key === "ArrowRight") showLightbox(1);
    }
  });

  // --- Ajuste de la primera foto (siempre vertical) — ver el comentario
  // equivalente en pieces/[slug].astro para el detalle completo. La caja
  // usa el mismo aspect ratio fijo que las portadas del grid, no el ratio
  // real de la imagen subida. ---
  const coleccion = document.querySelector<HTMLElement>(".coleccion");
  const coleccionGaleria = document.querySelector<HTMLElement>(".coleccion__galeria");
  const coleccionInquireLink = document.querySelector<HTMLElement>(".coleccion .inquire");
  // Debe coincidir con --cols / aspect-ratio de .item-card__frame en ItemCard.astro.
  const FIRST_PHOTO_ASPECT = 333 / 401;
  const COLECCION_MIN_COL = 24; // ver comentario equivalente en pieces/[slug].astro

  const fitFirstColeccionPhoto = () => {
    if (!coleccion || !coleccionGaleria || !coleccionInquireLink) return;
    if (window.matchMedia("(max-width: 900px)").matches) return;

    const aspect = FIRST_PHOTO_ASPECT;

    const measure = () => {
      const top = coleccionGaleria.getBoundingClientRect().top;
      return {
        photoHeight: coleccionGaleria.getBoundingClientRect().width / aspect,
        available: coleccionInquireLink.getBoundingClientRect().bottom - top,
      };
    };

    const applyPercentFor = (available: number) => {
      // grid-template-columns resuelve % contra el content-box (sin padding)
      // — clientWidth incluye el padding horizontal, hay que restarlo.
      const coleccionStyle = getComputedStyle(coleccion);
      const paddingX = parseFloat(coleccionStyle.paddingLeft || "0") + parseFloat(coleccionStyle.paddingRight || "0");
      const totalWidth = coleccion.clientWidth - paddingX;
      // Los % de grid-template-columns se resuelven contra el content-box
      // completo — el gap NO se resta antes de repartir (verificado empíricamente).
      const trackSpace = totalWidth;
      const neededColWidth = available * aspect;
      const percent = Math.max(COLECCION_MIN_COL, Math.min(45, (neededColWidth / trackSpace) * 100));
      coleccion.style.setProperty("--photo-col", `${percent}%`);
    };

    coleccion.style.setProperty("--photo-col", "45%");
    const first = measure();

    if (first.photoHeight <= first.available || first.available <= 0) {
      coleccionGaleria.classList.remove("coleccion__galeria--fit");
      return;
    }

    applyPercentFor(first.available);
    coleccionGaleria.classList.add("coleccion__galeria--fit");

    // 2ª pasada de ajuste fino — ver el comentario equivalente en pieces/[slug].astro.
    const second = measure();
    if (second.available > 0) {
      applyPercentFor(second.available);
    }
  };

  // Ver el comentario equivalente en pieces/[slug].astro.
  fitFirstColeccionPhoto();
  document.fonts?.ready.then(fitFirstColeccionPhoto);
  window.addEventListener("resize", fitFirstColeccionPhoto);
</script>

<style>
  .coleccion {
    --photo-col: 45%;
    position: relative;
    display: grid;
    grid-template-columns: var(--photo-col) 1fr;
    align-items: start;
    gap: var(--grid-gap);
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 40px var(--gutter) 4rem;
  }
  .coleccion__close {
    position: fixed;
    top: calc(var(--header-h) + 40px);
    right: var(--gutter);
    width: 18px;
    height: 18px;
    z-index: 20;
  }
  .coleccion__close span {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--color-text);
  }
  .coleccion__close span:first-child {
    transform: rotate(45deg);
  }
  .coleccion__close span:last-child {
    transform: rotate(-45deg);
  }

  /* Ver el comentario equivalente en pieces/[slug].astro: cuando la primera
     foto no cabría completa en lo visible, el script reduce --photo-col y
     agrega este padding para igualar el del panel de info. */
  .coleccion__galeria--fit {
    padding-bottom: 58px;
  }

  .coleccion__foto {
    position: relative;
    display: block;
    width: 100%;
    margin-bottom: 24px;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    appearance: none;
    outline: none;
  }
  .coleccion__foto:focus-visible {
    outline: 1px solid var(--color-hairline);
    outline-offset: 4px;
  }
  .coleccion__foto img {
    width: 100%;
    display: block;
  }

  /* Ver el comentario equivalente en pieces/[slug].astro. */
  .coleccion__foto--con-credito::before {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 40%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.5), transparent);
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }
  .coleccion__foto-credito {
    position: absolute;
    left: 12px;
    bottom: 12px;
    color: #fff;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }
  .coleccion__foto--con-credito:hover::before,
  .coleccion__foto--con-credito:focus-visible::before,
  .coleccion__foto:hover .coleccion__foto-credito,
  .coleccion__foto:focus-visible .coleccion__foto-credito {
    opacity: 1;
  }

  /* Ver el comentario equivalente en pieces/[slug].astro. */
  .coleccion__foto:first-child {
    aspect-ratio: 333 / 401;
  }
  .coleccion__foto:first-child img {
    height: 100%;
    object-fit: cover;
  }

  .coleccion__info-sticky {
    position: sticky;
    top: var(--header-h);
    height: calc(100vh - var(--header-h));
    display: flex;
    align-items: flex-end;
    padding-bottom: 58px;
  }
  .coleccion__info {
    max-width: 510px;
  }
  .coleccion__info h1 {
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .coleccion__badge {
    color: var(--color-text-muted);
    margin-bottom: 24px;
  }
  .coleccion__descripcion {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }
  .coleccion__descripcion :global(p + p) {
    margin-top: 1em;
  }

  .inquire {
    margin-top: 24px;
  }

  @media (max-width: 900px) {
    .coleccion {
      grid-template-columns: 1fr;
      padding-top: 72px;
    }
    .coleccion__info-sticky {
      position: static;
      height: auto;
      display: block;
      padding-bottom: 0;
    }
    .coleccion__info {
      max-width: none;
    }
  }
</style>

<style is:global>
  body.no-scroll {
    overflow: hidden;
  }

  /* Ver el comentario equivalente en pieces/[slug].astro. */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(160, 160, 160, 0.2);
    backdrop-filter: blur(24px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .lightbox.is-visible {
    opacity: 1;
    pointer-events: auto;
  }
  .lightbox__stage {
    /* Ver el comentario equivalente en pieces/[slug].astro. */
    position: relative;
    max-width: min(88vw, 1300px);
    max-height: 96vh;
  }
  .lightbox__stage img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 96vh;
    object-fit: contain;
  }
  .lightbox__close {
    position: absolute;
    top: 32px;
    right: var(--gutter);
    width: 20px;
    height: 20px;
    background: none;
    border: none;
    cursor: pointer;
    appearance: none;
    outline: none;
  }
  .lightbox__close:focus-visible {
    outline: 1px solid var(--color-hairline);
    outline-offset: 4px;
  }
  .lightbox__close span {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--color-text);
  }
  .lightbox__close span:first-child {
    transform: rotate(45deg);
  }
  .lightbox__close span:last-child {
    transform: rotate(-45deg);
  }
  .lightbox__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    appearance: none;
    outline: none;
  }
  .lightbox__arrow:focus-visible {
    outline: 1px solid var(--color-hairline);
    outline-offset: 4px;
  }
  .lightbox__arrow--prev {
    left: 24px;
  }
  .lightbox__arrow--next {
    right: 24px;
  }
  .lightbox__arrow span {
    display: block;
    width: 9px;
    height: 9px;
    border-top: 1px solid var(--color-text);
    border-right: 1px solid var(--color-text);
  }
  .lightbox__arrow--prev span {
    transform: rotate(-135deg);
    margin-left: 3px;
  }
  .lightbox__arrow--next span {
    transform: rotate(45deg);
    margin-right: 3px;
  }
</style>
