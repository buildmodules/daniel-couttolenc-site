---
import Base from "../layouts/Base.astro";
---
<Base
  title="Contact"
  description="Daniel Couttolenc welcomes collaborations, custom commissions and media requests."
  image="/site/contact-photo.png"
>
  <section class="contacto">
    <img class="contacto__photo" src="/site/contact-photo.png" alt="" />

    <div class="contacto__content">
      <h1 class="type-heading">Contact</h1>
      <p>Daniel Couttolenc welcomes collaborations, custom commissions and media requests.</p>

      <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" id="contact-form">
        <input type="hidden" name="form-name" value="contact" />
        <p class="sr-only"><label>Don't fill this out: <input name="bot-field" /></label></p>

        <div class="row">
          <label class="sr-only" for="field-name">Name</label>
          <input type="text" name="name" id="field-name" placeholder="Name*" required />
          <label class="sr-only" for="field-surname">Surname</label>
          <input type="text" name="surname" id="field-surname" placeholder="Surname" />
        </div>
        <label class="sr-only" for="field-email">Email</label>
        <input type="email" name="email" id="field-email" placeholder="Email*" required />
        <label class="sr-only" for="subject-field">Subject</label>
        <input type="text" name="subject" id="subject-field" placeholder="Subject" />
        <label class="sr-only" for="field-message">Message</label>
        <input type="text" name="message" id="field-message" placeholder="Message" />
        <button type="submit" class="type-cta" id="contact-submit">Submit</button>
        <p class="contacto__status" id="contact-status" role="status"></p>
      </form>
    </div>
  </section>
</Base>

<script>
  // Pre-fills the "Subject" field from a ?subject= query param, sent by the
  // "Inquire" button on a piece or collection page.
  const params = new URLSearchParams(window.location.search);
  const subject = params.get("subject");
  if (subject) {
    const field = document.getElementById("subject-field") as HTMLInputElement | null;
    if (field) field.value = subject;
  }

  // Envío por AJAX a Netlify Forms.
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("contact-status");
  const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !status || !submitBtn) return;
    submitBtn.disabled = true;
    status.textContent = "Sending…";
    try {
      const res = await fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams(new FormData(form) as any).toString(),
      });
      if (res.ok) {
        status.textContent = "Thank you — we'll be in touch soon.";
        form.reset();
      } else {
        status.textContent = "Something went wrong. Please try again.";
        submitBtn.disabled = false;
      }
    } catch {
      status.textContent = "Something went wrong. Please try again.";
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  .contacto {
    display: flex;
    align-items: flex-end;
    min-height: calc(100vh - var(--header-h));
    gap: var(--grid-gap);
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 40px var(--gutter) 3rem;
  }
  .contacto__photo {
    /* Igual que about-portrait: la foto se adapta al alto disponible (deja
       ~3rem de línea inferior antes del borde del viewport, vía el padding-
       bottom del container) en vez de derivar su alto de un aspect-ratio
       fijo. align-items: flex-end en .contacto ya alinea el texto a esa
       misma base inferior, sea cual sea el alto real de la foto. */
    flex: 0 0 45%;
    width: 45%;
    height: calc(100vh - var(--header-h) - 40px - 3rem);
    object-fit: cover;
    display: block;
  }
  .contacto__content {
    flex: 1;
    max-width: 510px;
  }
  .contacto h1 {
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .contacto > .contacto__content > p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    margin-bottom: 2.5rem;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 22px;
    position: relative;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    border-bottom: 1px solid var(--color-hairline);
  }
  .row input {
    border-bottom: none;
  }
  input {
    border: none;
    border-bottom: 1px solid var(--color-hairline);
    padding: 0.4rem 0;
    font-size: var(--fs-body);
    font-family: var(--font-sans);
    background: transparent;
    color: var(--color-text);
  }
  input::placeholder {
    color: var(--color-text-soft);
    opacity: 1;
  }
  input:focus {
    outline: none;
    border-bottom-color: var(--color-text);
  }
  button {
    align-self: flex-start;
    margin-top: 1rem;
    font-family: var(--font-sans);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-text);
  }
  .contacto__status {
    position: absolute;
    top: 100%;
    left: 0;
    margin: 8px 0 0;
    font-size: var(--fs-meta);
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .contacto {
      flex-direction: column;
      align-items: stretch;
      min-height: auto;
      padding-top: 72px;
    }
    .contacto__photo {
      flex-basis: auto;
      width: 100%;
      /* En mobile, alto natural en vez del calc() basado en viewport. */
      height: auto;
      aspect-ratio: 686 / 778;
    }
    .contacto__content {
      max-width: none;
    }
    .row {
      grid-template-columns: 1fr;
      gap: 22px;
      border-bottom: none;
    }
    .row input {
      border-bottom: 1px solid var(--color-hairline);
    }
  }
</style>
