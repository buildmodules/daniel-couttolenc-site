---
import Base from "../layouts/Base.astro";
import ItemCard from "../components/ItemCard.astro";
import { getCollection } from "astro:content";

const PAGE_SIZE = 24;

const piezas = (await getCollection("piezas"))
  .filter((p) => p.data.destacado !== false)
  .map((p) => ({ ...p.data, type: "piezas" as const, _order: p.data.orden ?? 999 }));

const colecciones = (await getCollection("colecciones"))
  .filter((c) => c.data.destacado !== false)
  .map((c) => ({ ...c.data, type: "colecciones" as const, _order: c.data.orden ?? 999 }));

const items = [...piezas, ...colecciones].sort((a, b) => a._order - b._order);
const page1 = items.slice(0, PAGE_SIZE);
const hasMore = items.length > PAGE_SIZE;
---
<Base title="Work">
  <section class="grid" id="grid">
    {page1.map((item) => (
      <ItemCard titulo={item.titulo} slug={item.slug} portada={item.portada} type={item.type} />
    ))}
  </section>

  {hasMore && (
    <div class="load-more-wrap">
      <a href="/pagina/2" id="load-more">Load more</a>
    </div>
  )}
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    padding: 1.5rem;
  }
  .load-more-wrap {
    text-align: center;
    padding: 2rem;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
