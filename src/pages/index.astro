---
import Base from "../layouts/Base.astro";
import HomeCarousel from "../components/HomeCarousel.astro";
import { getCollection } from "astro:content";

// El home slider es su propia colección en Tina (src/content/home-slider):
// cada slide trae su propia foto + una referencia a una pieza o colección
// existente (para saber a dónde enlaza) + un orden manual. Independiente del
// catálogo completo que se muestra en /work.
const slugFromRef = (ref?: string) => ref?.split("/").pop()?.replace(/\.md$/, "");

const [piezas, colecciones, slides] = await Promise.all([
  getCollection("piezas"),
  getCollection("colecciones"),
  getCollection("homeSlider"),
]);

const items = slides
  .map((slide) => {
    const piezaSlug = slugFromRef(slide.data.piezaRelacionada);
    const coleccionSlug = slugFromRef(slide.data.coleccionRelacionada);
    const pieza = piezaSlug ? piezas.find((p) => p.data.slug === piezaSlug) : undefined;
    const coleccion = coleccionSlug ? colecciones.find((c) => c.data.slug === coleccionSlug) : undefined;
    const related = pieza ?? coleccion;
    if (!related) return null;
    return {
      titulo: related.data.titulo,
      slug: related.data.slug,
      portada: slide.data.imagen,
      portadaMobile: slide.data.imagenMobile,
      type: (pieza ? "pieces" : "collections") as const,
      _order: slide.data.orden,
    };
  })
  .filter((item): item is NonNullable<typeof item> => item !== null)
  .sort((a, b) => a._order - b._order);
---
<Base
  title="Daniel Couttolenc"
  description="Daniel Couttolenc is a Mexican designer creating collectible objects."
  noScroll
>
  <!-- El home cabe siempre en un solo viewport (sin scroll). El alto del
       escenario lo da CSS (ver los estilos al final del archivo): ocupa lo que
       sobra entre el header y el footer. El script solo mide el escenario
       mismo (tamaño de layout) para dimensionar el slider; ya no lee
       window.innerHeight ni visualViewport, que con el zoom inteligente de
       Safari cambiaban y deformaban la página. -->
  <div class="home-stage" id="home-stage">
    <HomeCarousel items={items} />
  </div>
</Base>

<script>
  // Alto que le toca al slider = alto del escenario - 60px de aire mínimo
  // arriba y abajo. Se mide el escenario con ResizeObserver (tamaño de
  // layout, que no cambia con el zoom de pellizco/doble toque de Safari).
  const stage = document.getElementById("home-stage");
  if (stage) {
    const MIN_V_GAP = 60;
    const apply = (stageHeight: number) => {
      stage.style.setProperty("--carousel-avail-h", `${Math.max(0, stageHeight - MIN_V_GAP * 2)}px`);
    };
    apply(stage.clientHeight);
    new ResizeObserver(([entry]) => apply(entry.contentRect.height)).observe(stage);
  }
</script>

<style>
  /* El body del home es una columna de exactamente una pantalla: header fijo
     (su alto ya lo reserva main{padding-top}), main que crece y footer
     abajo. Así el escenario siempre mide "pantalla - header - footer" por
     CSS, sin JS. */
  :global(body.home-fit) {
    display: flex;
    flex-direction: column;
    /* Alto definido (no min-height) para que el escenario (flex: 1) tenga
       siempre un tamaño ya resuelto: pantalla - header - footer. */
    height: 100vh;
    height: 100dvh;
  }
  :global(body.home-fit main) {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .home-stage {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Salvavidas por si algún redondeo de px deja un pixel de sobra. */
    overflow: hidden;
    /* Valor inicial aproximado (pantalla - header 60px - footer ~123px -
       120px de aire) mientras corre el script de arriba, que lo reemplaza
       por la medida exacta del escenario. */
    --carousel-avail-h: max(0px, calc(100dvh - 303px));
  }

  /* El slider queda centrado por cajas entre el borde del nav y el footer;
     el footer tiene 3rem de padding-top antes de su primer texto, así que
     lo corremos la mitad (1.5rem) hacia abajo para que quede centrado entre
     el borde del nav y el TEXTO del footer. Debe coincidir con el
     padding-top de .site-footer en Base.astro. */
  :global(.home-stage .carousel) {
    /* scale(1.08): el slider crece 8% desde su centro (pedido de Daniel);
       como escala parejo, el centrado arriba/abajo se mantiene. */
    transform: translateY(1.5rem) scale(1.08);
  }
</style>
