---
import Base from "../layouts/Base.astro";
import HomeCarousel from "../components/HomeCarousel.astro";
import { getCollection } from "astro:content";

// El home slider es su propia colección en Tina (src/content/home-slider):
// cada slide trae su propia foto + una referencia a una pieza o colección
// existente (para saber a dónde enlaza) + un orden manual. Independiente del
// catálogo completo que se muestra en /work.
const slugFromRef = (ref?: string) => ref?.split("/").pop()?.replace(/\.md$/, "");

const [piezas, colecciones, slides] = await Promise.all([
  getCollection("piezas"),
  getCollection("colecciones"),
  getCollection("homeSlider"),
]);

const items = slides
  .map((slide) => {
    const piezaSlug = slugFromRef(slide.data.piezaRelacionada);
    const coleccionSlug = slugFromRef(slide.data.coleccionRelacionada);
    const pieza = piezaSlug ? piezas.find((p) => p.data.slug === piezaSlug) : undefined;
    const coleccion = coleccionSlug ? colecciones.find((c) => c.data.slug === coleccionSlug) : undefined;
    const related = pieza ?? coleccion;
    if (!related) return null;
    return {
      titulo: related.data.titulo,
      slug: related.data.slug,
      portada: slide.data.imagen,
      portadaMobile: slide.data.imagenMobile,
      type: (pieza ? "pieces" : "collections") as const,
      _order: slide.data.orden,
    };
  })
  .filter((item): item is NonNullable<typeof item> => item !== null)
  .sort((a, b) => a._order - b._order);
---
<Base
  title="Daniel Couttolenc"
  description="Daniel Couttolenc is a Mexican designer creating collectible objects."
  noScroll
>
  <!-- El home cabe siempre en un solo viewport (sin scroll) — este wrapper
       mide en JS el alto real del header y el footer y le da al slider
       exactamente el espacio que sobra entre los dos, centrado (flex), así
       el aire arriba (navbar→slider) y abajo (slider→footer) queda igual. -->
  <div class="home-stage" id="home-stage">
    <HomeCarousel items={items} />
  </div>
</Base>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const footer = document.querySelector<HTMLElement>(".site-footer");
  const stage = document.getElementById("home-stage");

  // Aire mínimo garantizado arriba/abajo del slider — sin esto, cuando el
  // ratio de la foto "gana" (la necesita tan alta como el espacio
  // disponible), la foto queda pegada al header y al footer con 0px de
  // por medio. Se resta de --carousel-avail-h (lo que ve el cálculo de
  // ancho en HomeCarousel.astro), no del alto real de .home-stage — el
  // centrado flex ya reparte ese aire igual arriba y abajo solo.
  const MIN_V_GAP = 40;

  if (header && footer && stage) {
    const updateStageHeight = () => {
      const headerH = header.getBoundingClientRect().height;
      const footerH = footer.getBoundingClientRect().height;
      const available = Math.max(0, window.innerHeight - headerH - footerH);
      stage.style.height = `${available}px`;
      // El slider (HomeCarousel.astro) usa esta variable para calcular su
      // propio ancho a partir del alto disponible, sin distorsionar el
      // aspect ratio de la foto — ver el comentario ahí.
      const availForCarousel = Math.max(0, available - MIN_V_GAP * 2);
      stage.style.setProperty("--carousel-avail-h", `${availForCarousel}px`);
    };

    updateStageHeight();
    window.addEventListener("resize", updateStageHeight);
    window.addEventListener("orientationchange", updateStageHeight);
    window.visualViewport?.addEventListener("resize", updateStageHeight);
    // El footer puede cambiar de alto cuando el webfont termina de cargar
    // (mueve el wrap del texto) — remedimos una vez más en ese momento.
    document.fonts?.ready.then(updateStageHeight);
    new ResizeObserver(updateStageHeight).observe(footer);
  }
</script>

<style>
  .home-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Salvavidas por si algún redondeo de px deja un pixel de sobra. */
    overflow: hidden;
  }

  /* Solo en home (body.no-scroll): el footer queda más pegado al borde del
     viewport (35px, antes 4rem/64px) — el ResizeObserver del script de
     arriba nota que el footer se achicó y le da ese espacio extra al
     slider, que sigue centrado igual entre el nav y el footer. */
  :global(body.no-scroll .site-footer) {
    padding-bottom: 35px;
  }
</style>
