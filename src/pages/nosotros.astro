---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const exhibiciones = (await getCollection("exhibiciones")).sort((a, b) => {
  const oa = a.data.orden ?? 999;
  const ob = b.data.orden ?? 999;
  if (oa !== ob) return oa - ob;
  return b.data.anio.localeCompare(a.data.anio);
});
---
<Base title="About">
  <section class="about">
    <img class="about__portrait" id="about-portrait" src="/site/about-portrait.png" alt="Daniel Couttolenc" />

    <div class="about__content" id="about-content">
      <div class="about__intro" id="about-intro">
        <h1 class="type-heading">About</h1>
        <p>
          Daniel Couttolenc is a Mexican designer whose work begins with curiosity.
        </p>
        <p>
          Drawn to design from an early age, he was also interested in questions of
          spirituality, meaning, and inner balance. The study of sacred geometry
          eventually revealed a connection between them.
        </p>
        <p>
          Each piece begins as an impression—something observed, experienced, or felt.
          Guided by intuition and refined through proportion, geometry, and material
          exploration, these impressions gradually take shape as objects. Created as
          pieces of harmony, they invite a sense of presence and connection.
        </p>
      </div>

      <h2 class="type-heading">Exhibitions</h2>
      <ul class="about__exhibitions" id="exhibitions-list">
        {exhibiciones.map((e) => (
          <li data-foto={e.data.foto ?? ""}>
            <span class="about__year">{e.data.anio}</span>
            <span>{e.data.nombre}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="about__float" id="exhibitions-float" aria-hidden="true">
    <img id="exhibitions-float-img" alt="" />
  </div>
</Base>

<script>
  const list = document.getElementById("exhibitions-list");
  const float = document.getElementById("exhibitions-float");
  const floatImg = document.getElementById("exhibitions-float-img") as HTMLImageElement | null;

  if (list && float && floatImg) {
    const items = Array.from(list.querySelectorAll<HTMLLIElement>("li[data-foto]"));
    const OFFSET_X = 28;
    const OFFSET_Y = -80;

    const positionFloat = (clientX: number, clientY: number) => {
      const rect = float.getBoundingClientRect();
      let x = clientX + OFFSET_X;
      let y = clientY + OFFSET_Y;
      x = Math.min(x, window.innerWidth - rect.width - 16);
      y = Math.max(y, 16);
      float.style.transform = `translate(${x}px, ${y}px)`;
    };

    items.forEach((item) => {
      const foto = item.dataset.foto;
      if (!foto) return;

      item.addEventListener("mouseenter", (e) => {
        floatImg.src = foto;
        float.classList.add("is-visible");
        positionFloat((e as MouseEvent).clientX, (e as MouseEvent).clientY);
      });
    });

    list.addEventListener("mousemove", (e) => {
      positionFloat(e.clientX, e.clientY);
    });

    list.addEventListener("mouseleave", () => {
      float.classList.remove("is-visible");
    });
  }
</script>

<script>
  // Alinea el bottom de about__intro con el bottom de la foto (solo desktop,
  // donde la foto va sticky junto a la columna de texto). La altura de ambas
  // es fluida (%), así que se recalcula con ResizeObserver en vez de un valor fijo.
  const portrait = document.getElementById("about-portrait") as HTMLImageElement | null;
  const content = document.getElementById("about-content");
  const intro = document.getElementById("about-intro");

  if (portrait && content && intro) {
    const isDesktop = () => window.matchMedia("(min-width: 901px)").matches;

    const align = () => {
      if (!isDesktop()) {
        content.style.paddingTop = "";
        return;
      }
      const pad = Math.max(0, portrait.offsetHeight - intro.offsetHeight);
      content.style.paddingTop = `${pad}px`;
    };

    const ro = new ResizeObserver(align);
    ro.observe(portrait);
    ro.observe(intro);
    window.addEventListener("resize", align);

    if (portrait.complete) {
      align();
    } else {
      portrait.addEventListener("load", align, { once: true });
    }
  }
</script>

<style>
  /* En Figma, la pantalla de About usa un fondo #CBCBCB propio, distinto del
     #F7F7F7 global del resto del sitio. */
  :global(body) {
    background: #cbcbcb;
  }

  .about {
    display: grid;
    grid-template-columns: 502px 1fr;
    align-items: start;
    gap: 3.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 40px var(--gutter) 4rem;
  }
  .about__portrait {
    width: 100%;
    aspect-ratio: 502 / 584;
    object-fit: cover;
    display: block;
    position: sticky;
    top: calc(var(--header-h) + 40px);
  }
  .about__intro {
    max-width: 30rem;
  }
  .about h1 {
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .about p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    margin-bottom: 1em;
  }
  .about h2 {
    text-transform: uppercase;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
  .about__exhibitions {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .about__exhibitions li {
    display: flex;
    gap: 40px;
    padding: 9px 0;
    border-top: 1px solid var(--color-hairline);
    font-size: var(--fs-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    cursor: default;
  }
  .about__exhibitions li[data-foto]:not([data-foto=""]) {
    cursor: pointer;
  }
  .about__exhibitions li:last-child {
    border-bottom: 1px solid var(--color-hairline);
  }
  .about__year {
    flex: 0 0 40px;
  }

  .about__float {
    position: fixed;
    top: 0;
    left: 0;
    width: 188px;
    height: 213px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
    z-index: 40;
    will-change: transform;
  }
  .about__float.is-visible {
    opacity: 1;
  }
  .about__float img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
      padding-top: 72px;
    }
    .about__portrait {
      position: static;
    }
    .about__float {
      display: none;
    }
  }
</style>
