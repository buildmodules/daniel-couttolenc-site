---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const piezas = await getCollection("piezas");
  return piezas.map((pieza) => ({
    params: { slug: pieza.data.slug },
    props: { pieza },
  }));
}

const { pieza } = Astro.props as any;
const { Content } = await render(pieza);
const {
  titulo,
  galeria,
  portada,
  dimensiones,
  materialTipo,
  variantes,
  leadTime,
  badge,
  mostrarDisclaimer,
  creditosFotos,
  metaTitle,
  metaDescription,
  ogImage,
} = pieza.data;
const imagenes: string[] = galeria ?? (portada ? [portada] : []);
// Créditos de foto: dispersos y opcionales — solo la foto puntual que lo
// necesita (ver content.config.ts). Match por igualdad de string contra la ruta.
const creditosPorFoto = new Map((creditosFotos ?? []).map((c: any) => [c.imagen, c.texto]));
const mensajeInquire = `I'd like to request a quote for ${titulo}.`;
// Piezas redondas (ej. CALATEA) miden diámetro × alto, no W × D × H — el
// dato "Ø152 x 76cm" no está incompleto, es la etiqueta la que no le
// corresponde. Se detecta por el prefijo "Ø" en vez de un campo nuevo en
// el CMS, así cualquier pieza redonda futura queda bien automáticamente.
const dimensionesRedondas = dimensiones?.trim().startsWith("Ø") ?? false;

const materialNote =
  materialTipo === "Cast Bronze"
    ? "Cast in bronze using the traditional lost-wax process, each piece carries subtle variations in texture and surface. These characteristics are not imperfections, but expressions of its handcrafted nature."
    : "Crafted from solid wood, each piece reveals its natural grain, tonal variation, and organic markings. These characteristics are not imperfections, but expressions of the material itself.";
---
<Base
  title={metaTitle || titulo}
  description={metaDescription}
  image={ogImage || portada}
>
  <article class="pieza">
    <a class="pieza__close" href="/work" aria-label="Cerrar">
      <span></span>
      <span></span>
    </a>

    <div class="pieza__galeria">
      {imagenes.map((img: string, i: number) => (
        <button
          type="button"
          class:list={["pieza__foto", creditosPorFoto.has(img) && "pieza__foto--con-credito"]}
          data-index={i}
        >
          <img src={img} alt={titulo} loading={i === 0 ? "eager" : "lazy"} />
          {creditosPorFoto.has(img) && (
            <span class="pieza__foto-credito">{creditosPorFoto.get(img)}</span>
          )}
        </button>
      ))}
    </div>

    <div class="pieza__info-sticky">
      <div class="pieza__info">
        <div class="pieza__title-row">
          <h1 class="type-heading">{titulo}</h1>
          <!-- Mismo trigger que el botón Inquire de abajo (#inquire-open) —
               solo visible en mobile, donde el diseño lo pone junto al
               título en vez de al fondo de la columna de info. -->
          <button type="button" class="pieza__inquire-top" id="inquire-open-mobile">Inquire</button>
        </div>
        {badge && <p class="pieza__badge type-label">{badge}</p>}
        <div class="pieza__descripcion"><Content /></div>

        {dimensiones && (
          <>
            <p class="pieza__label type-label">
              Dimensions ({dimensionesRedondas ? "Ø × H" : "W × D × H"}):
            </p>
            <hr />
            <p class="pieza__dimensiones">{dimensiones}</p>
            <hr />
          </>
        )}

        {variantes && variantes.length > 0 && (
          <>
            <p class="pieza__label type-label">Material: <span class="pieza__label-value">{materialTipo ?? "Solid Wood"}</span></p>
            <hr />
            <ul class="pieza__variantes">
              {variantes.map((v: any) => {
                // "|" marca dónde parte a la segunda línea (ej. "Red Oak|Black
                // finish" → "Red Oak" / "Black finish") — un renglón fijo por
                // contenido, no por wrap del texto, que se rompe distinto según
                // el ancho de columna. Sin "|" queda en una sola línea.
                const lineas = v.nombre.split("|");
                return (
                  <li>
                    {v.imagen && <img src={v.imagen} alt={lineas.join(" ")} class="swatch" />}
                    <span>
                      {lineas.map((linea: string, i: number) => (
                        <>
                          {i > 0 && <br />}
                          {linea}
                        </>
                      ))}
                    </span>
                  </li>
                );
              })}
            </ul>
            <hr />
            {mostrarDisclaimer !== false && (
              <p class="pieza__disclaimer">Dimensions &amp; material customizable upon request.</p>
            )}
          </>
        )}

        {leadTime && (
          <p class="pieza__leadtime"><strong class="pieza__label-inline type-label">Lead time {leadTime}</strong></p>
        )}

        <p class="pieza__material-note">{materialNote}</p>

        <button type="button" class="inquire type-cta" id="inquire-open">
          Inquire
        </button>
      </div>
    </div>
  </article>

  <!-- Lightbox de galería -->
  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button type="button" class="lightbox__close" id="lightbox-close" aria-label="Cerrar">
      <span></span>
      <span></span>
    </button>
    <button type="button" class="lightbox__arrow lightbox__arrow--prev" id="lightbox-prev" aria-label="Foto anterior">
      <span></span>
    </button>
    <div class="lightbox__stage">
      <img id="lightbox-img" src="" alt={titulo} />
    </div>
    <button type="button" class="lightbox__arrow lightbox__arrow--next" id="lightbox-next" aria-label="Foto siguiente">
      <span></span>
    </button>
  </div>

  <!-- Modal de Inquire -->
  <div class="inquire-modal" id="inquire-modal" aria-hidden="true">
    <div class="inquire-modal__panel">
      <button type="button" class="inquire-modal__close" id="inquire-close" aria-label="Cerrar">
        <span></span>
        <span></span>
      </button>

      <form id="inquire-form" name="inquire" method="POST" data-netlify="true" netlify-honeypot="inquire-bot-field">
        <input type="hidden" name="form-name" value="inquire" />
        <p class="sr-only"><label>Don't fill this out: <input name="inquire-bot-field" /></label></p>
        <input type="hidden" name="subject" value={`Inquiry: ${titulo}`} />
        <label class="sr-only" for="inquire-email">Email</label>
        <input type="email" name="email" id="inquire-email" placeholder="Email*" required />
        <label class="sr-only" for="inquire-message">Message</label>
        <textarea name="message" id="inquire-message" class="is-prefilled" rows="4">{mensajeInquire}</textarea>
        <button type="submit" class="type-cta" id="inquire-submit">Submit</button>
        <p class="inquire-modal__status" id="inquire-status" role="status"></p>
      </form>
    </div>
  </div>
</Base>

<script>
  // --- Lightbox de galería ---
  const photos = Array.from(document.querySelectorAll<HTMLButtonElement>(".pieza__foto"));
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement | null;
  const lightboxClose = document.getElementById("lightbox-close");
  const lightboxPrev = document.getElementById("lightbox-prev");
  const lightboxNext = document.getElementById("lightbox-next");
  const sources = photos.map((btn) => btn.querySelector("img")?.getAttribute("src") ?? "");
  let lightboxIndex = 0;

  const openLightbox = (index: number) => {
    if (!lightbox || !lightboxImg || sources.length === 0) return;
    lightboxIndex = (index + sources.length) % sources.length;
    lightboxImg.src = sources[lightboxIndex];
    lightbox.classList.add("is-visible");
    lightbox.setAttribute("aria-hidden", "false");
    document.body.classList.add("no-scroll");
  };

  const closeLightbox = () => {
    if (!lightbox) return;
    lightbox.classList.remove("is-visible");
    lightbox.setAttribute("aria-hidden", "true");
    document.body.classList.remove("no-scroll");
  };

  const showLightbox = (delta: number) => openLightbox(lightboxIndex + delta);

  photos.forEach((btn) => {
    btn.addEventListener("click", () => openLightbox(Number(btn.dataset.index)));
  });
  lightboxClose?.addEventListener("click", closeLightbox);
  lightboxPrev?.addEventListener("click", () => showLightbox(-1));
  lightboxNext?.addEventListener("click", () => showLightbox(1));
  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  // Swipe para navegar (reemplaza las flechas, que se ocultan en mobile —
  // mismo umbral/patrón que el carrusel del home).
  let lightboxTouchStartX = 0;
  lightbox?.addEventListener("touchstart", (e) => {
    lightboxTouchStartX = e.touches[0].clientX;
  }, { passive: true });
  lightbox?.addEventListener("touchend", (e) => {
    const delta = e.changedTouches[0].clientX - lightboxTouchStartX;
    if (Math.abs(delta) > 40) showLightbox(delta > 0 ? -1 : 1);
  }, { passive: true });

  // --- Modal de Inquire ---
  const inquireOpenBtn = document.getElementById("inquire-open");
  const inquireModal = document.getElementById("inquire-modal");
  const inquireClose = document.getElementById("inquire-close");
  const inquireForm = document.getElementById("inquire-form") as HTMLFormElement | null;
  const inquireStatus = document.getElementById("inquire-status");
  const inquireSubmit = document.getElementById("inquire-submit") as HTMLButtonElement | null;

  const openInquire = () => {
    if (!inquireModal) return;
    inquireModal.classList.add("is-visible");
    inquireModal.setAttribute("aria-hidden", "false");
    document.body.classList.add("no-scroll");
  };

  const closeInquire = () => {
    if (!inquireModal) return;
    inquireModal.classList.remove("is-visible");
    inquireModal.setAttribute("aria-hidden", "true");
    document.body.classList.remove("no-scroll");
  };

  inquireOpenBtn?.addEventListener("click", openInquire);
  document.getElementById("inquire-open-mobile")?.addEventListener("click", openInquire);
  inquireClose?.addEventListener("click", closeInquire);
  inquireModal?.addEventListener("click", (e) => {
    if (e.target === inquireModal) closeInquire();
  });

  // El mensaje viene pre-llenado pero se ve gris, como un placeholder, hasta
  // que el usuario empieza a editarlo.
  const inquireMessage = document.getElementById("inquire-message");
  inquireMessage?.addEventListener("focus", () => {
    inquireMessage.classList.remove("is-prefilled");
  });

  inquireForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!inquireForm || !inquireStatus || !inquireSubmit) return;
    inquireSubmit.disabled = true;
    inquireStatus.textContent = "Sending…";
    try {
      const res = await fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams(new FormData(inquireForm) as any).toString(),
      });
      if (res.ok) {
        inquireStatus.textContent = "Thank you — we'll be in touch soon.";
        inquireForm.reset();
      } else {
        inquireStatus.textContent = "Something went wrong. Please try again.";
        inquireSubmit.disabled = false;
      }
    } catch {
      inquireStatus.textContent = "Something went wrong. Please try again.";
      inquireSubmit.disabled = false;
    }
  });

  // --- Cerrar con Escape ---
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    closeLightbox();
    closeInquire();
  });
  document.addEventListener("keydown", (e) => {
    if (lightbox?.classList.contains("is-visible")) {
      if (e.key === "ArrowLeft") showLightbox(-1);
      if (e.key === "ArrowRight") showLightbox(1);
    }
  });

  // --- Ajuste de la primera foto (siempre vertical) ---
  // La caja de la primera foto usa el MISMO aspect ratio que las portadas
  // del grid (.item-card__frame en ItemCard.astro) — no el ratio real de la
  // imagen subida. Daniel recorta portada/primera foto a ese ratio antes de
  // subirla; object-fit: cover (ver CSS) llena la caja borde a borde.
  // Si al ancho normal de la columna esa caja no cabría completa en lo
  // visible (viewport - top offset - el mismo padding-bottom del panel de
  // info), reducimos el ancho de la columna (--photo-col) lo justo para que
  // sí quepa. Como todas las fotos comparten esa columna, todas heredan el
  // nuevo ancho — se ven consistentes entre sí.
  const pieza = document.querySelector<HTMLElement>(".pieza");
  const galeria = document.querySelector<HTMLElement>(".pieza__galeria");
  const inquireBtn = document.getElementById("inquire-open");

  // --- Aire mínimo arriba del título ---
  // El panel de info se ancla abajo (align-items:flex-end, ver CSS) para
  // que Inquire llegue a la misma línea que el final de la foto — en
  // pantallas bajas (o piezas con mucho texto/materiales) eso podía dejar
  // muy poco aire entre el nav y el título. Recortamos el padding-bottom
  // (58px de base) hasta un mínimo si hace falta, para garantizar un aire
  // consistente arriba sin importar el alto de pantalla.
  const infoSticky = document.querySelector<HTMLElement>(".pieza__info-sticky");
  const infoH1 = document.querySelector<HTMLElement>(".pieza__info h1");
  const MIN_TOP_GAP = 120;
  const BASE_PADDING_BOTTOM = 58;
  const MIN_PADDING_BOTTOM = 16;

  const applyMinTopGap = () => {
    if (!infoSticky || !infoH1) return;
    if (window.matchMedia("(max-width: 900px)").matches) return;
    // Reseteamos primero para medir el gap "natural" antes de recortar —
    // si no, una corrida previa ya recortada sesga la medición.
    infoSticky.style.paddingBottom = `${BASE_PADDING_BOTTOM}px`;
    const gap = infoH1.getBoundingClientRect().top - infoSticky.getBoundingClientRect().top;
    if (gap < MIN_TOP_GAP) {
      const deficit = MIN_TOP_GAP - gap;
      infoSticky.style.paddingBottom = `${Math.max(MIN_PADDING_BOTTOM, BASE_PADDING_BOTTOM - deficit)}px`;
    }
  };
  // Debe coincidir con --cols / aspect-ratio de .item-card__frame en ItemCard.astro.
  const FIRST_PHOTO_ASPECT = 333 / 401;
  // El requisito de los diseñadores (que la foto siempre se vea completa,
  // sin cortarse) es la regla dura — tiene prioridad sobre no verse angosta.
  // Este mínimo es solo un salvavidas para casos extremos, deliberadamente
  // bajo para no forzar un ancho más grande del que la foto realmente
  // necesita para llegar justo hasta abajo (altura del botón Inquire).
  const MIN_COL = 24;

  const fitFirstPhoto = () => {
    if (!pieza || !galeria || !inquireBtn) return;
    if (window.matchMedia("(max-width: 900px)").matches) return; // en mobile el layout ya es 1 columna

    const measure = () => {
      const top = galeria.getBoundingClientRect().top;
      return {
        // El objetivo real es "la foto llega hasta donde termina Inquire" —
        // se mide directo en vez de asumir un padding fijo, para que quede exacto.
        available: inquireBtn.getBoundingClientRect().bottom - top,
      };
    };

    const applyPercentFor = (available: number) => {
      // grid-template-columns resuelve % contra el content-box (sin padding)
      // — clientWidth incluye el padding horizontal, hay que restarlo.
      const piezaStyle = getComputedStyle(pieza);
      const paddingX = parseFloat(piezaStyle.paddingLeft || "0") + parseFloat(piezaStyle.paddingRight || "0");
      const totalWidth = pieza.clientWidth - paddingX;
      // Los % de grid-template-columns se resuelven contra el content-box
      // completo — el gap NO se resta antes de repartir (verificado empíricamente).
      const trackSpace = totalWidth;
      const neededColWidth = available * FIRST_PHOTO_ASPECT;
      // Ver el comentario equivalente en collections/[slug].astro sobre el
      // techo (antes 45, fijo — y 70 tampoco alcanzaba en pantallas grandes).
      // La columna de info tiene su propio max-width (510px), así que no se
      // "aprieta" aunque esta columna crezca mucho — 92 es solo para dejar
      // un margen mínimo visible del lado del texto.
      const percent = Math.max(MIN_COL, Math.min(92, (neededColWidth / trackSpace) * 100));
      pieza.style.setProperty("--photo-col", `${percent}%`);
    };

    // Siempre ajustamos al espacio disponible — para achicar la foto si a
    // 45% se pasaría del Inquire, pero también para AGRANDARLA si a 45% se
    // queda corta (pantallas grandes: el alto del viewport crece pero el
    // ancho de columna no, porque está topado por --max-width). Antes solo
    // se corregía el primer caso, así que en pantallas grandes la foto no
    // llegaba a la misma línea base que el texto.
    galeria.classList.add("pieza__galeria--fit");

    const first = measure();
    if (first.available <= 0) return;
    applyPercentFor(first.available);

    // 2ª pasada: al angostar la columna de info (1fr) su texto puede haber
    // reajustado líneas y movido Inquire — remedimos en el nuevo estado y
    // afinamos una vez más para que la foto llegue justo hasta ahí.
    const second = measure();
    if (second.available > 0) {
      applyPercentFor(second.available);
    }
  };

  // applyMinTopGap corre antes que fitFirstPhoto (y de nuevo después): el
  // padding-bottom que recorta mueve a Inquire, así que la foto debe
  // ajustarse a esa posición final, no a la de antes del recorte.
  const runLayoutPass = () => {
    applyMinTopGap();
    fitFirstPhoto();
    applyMinTopGap();
    fitFirstPhoto();
  };

  // El ratio ya no depende de que la imagen cargue (es fijo), pero el texto
  // de la columna de info sí puede reflowear cuando el webfont termina de
  // cargar y mueve el botón Inquire — remedimos una vez más en ese momento.
  runLayoutPass();
  document.fonts?.ready.then(runLayoutPass);
  window.addEventListener("resize", runLayoutPass);

  // --- Contraste automático del crédito de foto ---
  // El crédito ahora está siempre visible (sin overlay al hover) — para que
  // se lea bien sobre cualquier foto, muestreamos en un canvas el color
  // promedio de la esquina donde cae el texto (replicando el recorte real
  // de object-fit:cover cuando aplica, vía las mismas cuentas que hace el
  // navegador) y elegimos blanco o negro según su luminancia. Sabido
  // trade-off: es un promedio de la esquina completa, así que una esquina
  // mitad clara/mitad oscura puede fallar — para eso está el text-shadow
  // del CSS como red de seguridad, no reemplaza un buen recorte de foto.
  const updateCreditContrast = () => {
    document.querySelectorAll<HTMLElement>(".pieza__foto--con-credito").forEach((foto) => {
      const img = foto.querySelector("img");
      const credito = foto.querySelector<HTMLElement>(".pieza__foto-credito");
      if (!img || !credito) return;

      const sample = () => {
        const boxW = foto.clientWidth;
        const boxH = foto.clientHeight;
        const naturalW = img.naturalWidth;
        const naturalH = img.naturalHeight;
        if (!boxW || !boxH || !naturalW || !naturalH) return;

        // Mismo cálculo que hace el navegador para object-fit:cover — si la
        // foto no lo usa, el resultado es simplemente la imagen completa
        // (su ratio ya coincide con el de la caja), así que esta única
        // fórmula cubre ambos casos.
        const boxRatio = boxW / boxH;
        const imgRatio = naturalW / naturalH;
        let sx: number, sy: number, sw: number, sh: number;
        if (imgRatio > boxRatio) {
          sh = naturalH;
          sw = sh * boxRatio;
          sx = (naturalW - sw) / 2;
          sy = 0;
        } else {
          sw = naturalW;
          sh = sw / boxRatio;
          sx = 0;
          sy = (naturalH - sh) / 2;
        }

        // Solo la esquina abajo-izquierda donde cae el texto, no la foto
        // entera — así reacciona a lo que hay justo detrás del crédito.
        const REGION_W = 0.4;
        const REGION_H = 0.3;
        const regionSx = sx;
        const regionSy = sy + sh * (1 - REGION_H);
        const regionSw = sw * REGION_W;
        const regionSh = sh * REGION_H;

        const canvas = document.createElement("canvas");
        canvas.width = 8;
        canvas.height = 8;
        const ctx = canvas.getContext("2d");
        if (!ctx) return;
        try {
          ctx.drawImage(img, regionSx, regionSy, regionSw, regionSh, 0, 0, 8, 8);
          const { data } = ctx.getImageData(0, 0, 8, 8);
          let total = 0;
          for (let i = 0; i < data.length; i += 4) {
            total += data[i] * 0.299 + data[i + 1] * 0.587 + data[i + 2] * 0.114;
          }
          const avg = total / (data.length / 4);
          credito.classList.toggle("is-on-light", avg > 150);
        } catch {
          // Foto cross-origin u otro error de canvas — se queda en blanco
          // (default), el text-shadow sigue dando algo de contraste.
        }
      };

      if (img.complete && img.naturalWidth) sample();
      else img.addEventListener("load", sample, { once: true });
    });
  };

  updateCreditContrast();
  window.addEventListener("resize", updateCreditContrast);

</script>

<style>
  .pieza {
    --photo-col: 45%;
    position: relative;
    display: grid;
    grid-template-columns: var(--photo-col) 1fr;
    align-items: start;
    gap: var(--grid-gap);
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 40px var(--gutter) 4rem;
  }
  .pieza__close {
    position: fixed;
    top: calc(var(--header-h) + 40px);
    right: var(--gutter);
    width: 18px;
    height: 18px;
    z-index: 20;
  }
  .pieza__close span {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--color-text);
  }
  .pieza__close span:first-child {
    transform: rotate(45deg);
  }
  .pieza__close span:last-child {
    transform: rotate(-45deg);
  }

  /* Cuando la primera foto (siempre vertical) no cabría completa en la
     altura visible, el script de abajo reduce --photo-col para que sí
     quepa — y como todas las fotos comparten esa columna, todas heredan
     el mismo ancho. En ese caso especial, igualamos el padding inferior
     al del panel de info (58px) para que ambas columnas terminen alineadas. */
  .pieza__galeria--fit {
    padding-bottom: 58px;
  }

  .pieza__foto {
    position: relative;
    display: block;
    width: 100%;
    margin-bottom: 24px;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    appearance: none;
    outline: none;
  }
  .pieza__foto:focus-visible {
    outline: 1px solid var(--color-hairline);
    outline-offset: 4px;
  }
  .pieza__foto:last-child {
    margin-bottom: 0;
  }
  .pieza__foto img {
    width: 100%;
    display: block;
  }

  /* Crédito de foto (ej. "Photo courtesy of X") — siempre visible, sin
     overlay/gradiente detrás. El color (blanco u oscuro) lo decide JS
     muestreando la esquina real de la foto (ver updateCreditContrast) y
     togglea .is-on-light; el text-shadow de abajo es solo la red de
     seguridad para el caso raro de una esquina con mezcla de claro/oscuro,
     donde el muestreo promedio puede no alcanzar. */
  .pieza__foto-credito {
    position: absolute;
    left: 12px;
    bottom: 12px;
    color: #fff;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    pointer-events: none;
    text-shadow: 0 0 3px rgba(255, 255, 255, 0.5), 0 0 6px rgba(0, 0, 0, 0.35);
  }
  .pieza__foto-credito.is-on-light {
    color: #000;
  }

  /* Primera foto: misma caja (aspect ratio) que las portadas del grid —
     ver .item-card__frame en ItemCard.astro. Daniel recorta el archivo a
     este ratio antes de subirlo, así que va a cover (llena la caja borde a
     borde); si algún día sube algo que no venga exacto, cover recorta el
     sobrante en vez de dejar espacio en blanco. */
  .pieza__foto:first-child {
    aspect-ratio: 333 / 401;
  }
  .pieza__foto:first-child img {
    height: 100%;
    object-fit: cover;
  }

  .pieza__info-sticky {
    position: sticky;
    top: var(--header-h);
    height: calc(100vh - var(--header-h));
    display: flex;
    align-items: flex-end;
    padding-bottom: 58px;
  }
  /* Sin max-width (pedido del diseño) — la columna de info ahora usa todo
     el ancho de su columna del grid (1fr). */
  /* Espaciado entre bloques de info reducido 25% (pedido del diseño) —
     cada valor de abajo es el original × 0.75. */
  .pieza__info h1 {
    margin-bottom: 24px;
  }
  /* Cuando hay badge, va pegado al título (como en collections) — el h1
     usa un margin chico en vez del que separa título de párrafo. Apunta al
     wrapper (.pieza__title-row), no a h1 directo, porque el botón de
     Inquire mobile ahora vive entre el h1 y el badge en el DOM. */
  .pieza__title-row:has(+ .pieza__badge) h1 {
    margin-bottom: 6px;
  }
  /* En desktop el wrapper es invisible (misma caja que antes, solo h1) — el
     botón de Inquire mobile no ocupa lugar ni se ve aquí. */
  .pieza__title-row {
    display: contents;
  }
  .pieza__inquire-top {
    display: none;
  }
  .pieza__badge {
    color: var(--color-text-muted);
    margin-bottom: 18px;
  }
  .pieza__dimensiones {
    white-space: pre-line;
    margin: 4px 0 0;
  }
  .pieza__descripcion {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }
  .pieza__descripcion :global(p + p) {
    margin-top: 1em;
  }

  /* Espaciado del bloque de info: cada gap se define una sola vez, como
     margin-top del elemento que sigue, para que no haya colapso de márgenes
     entre hermanos y cada transición quede con el valor exacto que se quiere. */
  hr {
    border: none;
    border-top: 1px solid var(--color-hairline);
    margin: 0;
  }

  .pieza__label {
    margin: 30px 0 0;
  }
  .pieza__label-value {
    text-transform: none;
    font-weight: var(--fw-regular);
  }
  .pieza__label + hr {
    margin-top: 4px;
  }
  .pieza__dimensiones + hr {
    margin-top: 4px;
  }

  /* flex-wrap con un width fijo por item (no grid de 4 columnas) — así las
     piezas con hasta 7 materiales (el máximo hoy, ej. CACTO) caben en una
     sola fila en desktop en vez de partirse a una segunda fila. En mobile
     el mismo flex-wrap se acomoda solo, menos por fila. */
  .pieza__variantes {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 10px;
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
  }
  .pieza__variantes + hr {
    margin-top: 12px;
  }
  .pieza__disclaimer {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text);
    margin: 12px 0 0;
  }
  .pieza__leadtime {
    margin-top: 36px;
  }
  .pieza__material-note {
    margin-top: 15px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }
  .pieza__variantes li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
    /* Width fijo — el item no crece ni se achica. 96px es lo justo para
       que el renglón más largo actual ("Cinnamon finish") no vuelva a
       partirse en una 3ª línea — antes con 64px sí pasaba. Con esto 7
       materiales ya no siempre caben en una sola fila en pantallas
       angostas de escritorio, pero el texto nunca pasa de 2 líneas. */
    flex: 0 0 auto;
    width: 96px;
    /* --fs-caption/--lh-caption: el token que ya existía justo para esto
       ("material swatch captions") — 25% menos que el texto de antes. */
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    font-weight: var(--fw-medium);
  }
  .swatch {
    /* 25% más chico (pedido del diseño) — 48px → 36px. */
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
  }

  .inquire {
    margin-top: 25px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    appearance: none;
    outline: none;
    transition: color 0.2s ease;
  }
  .inquire:hover {
    color: var(--color-text-muted);
  }
  .inquire:focus-visible {
    outline: 1px solid var(--color-hairline);
    outline-offset: 4px;
  }

  @media (max-width: 900px) {
    .pieza {
      grid-template-columns: 1fr;
      /* Sin padding extra: la galería empieza justo debajo del header fijo
         (ese offset ya lo da `main{padding-top:var(--header-h)}` en
         Base.astro). La X (.pieza__close, fixed) queda entonces flotando
         directo sobre la primera foto en vez de en un hueco en blanco. */
      padding-top: 0;
      /* La galería ahora es edge-to-edge (sin el --gutter del artículo) —
         el inset horizontal se mueve a .pieza__info, que es la única otra
         hija directa con contenido visible (.pieza__close es fixed, no le
         afecta el padding del artículo). */
      padding-left: 0;
      padding-right: 0;
    }
    /* Más adentro que el default (arriba/derecha) para que quede
       claramente sobre la foto, no en el margen blanco de arriba. */
    .pieza__close {
      top: calc(var(--header-h) + 12px);
      right: calc(var(--gutter) + 12px);
    }
    .pieza__info-sticky {
      position: static;
      height: auto;
      display: block;
      padding-bottom: 0;
    }
    .pieza__info {
      max-width: none;
      padding: 0 var(--gutter);
    }

    /* Como Zara Home mobile: la galería es un carrete vertical de una foto
       a la vez (scroll-snap), edge-to-edge. El alto de cada "página" del
       carrete usa el mismo aspect ratio que la caja de portada del grid
       (333/401) para que se sienta consistente con el resto del sitio —
       no el ratio real de cada imagen. Al llegar a la última foto y seguir
       el swipe, no hace falta JS: es scroll chaining nativo del navegador,
       el gesto se lo pasa a la página y sigue hacia .pieza__info. */
    .pieza__galeria {
      /* flex column + gap en vez de block: así el espacio entre fotos es
         real (se ve al pasar de una a otra durante el swipe) sin afectar
         el alto de cada "página" (aspect-ratio de abajo sigue siendo el
         de una sola foto — el gap se suma aparte, no lo reemplaza). */
      display: flex;
      flex-direction: column;
      gap: 16px;
      aspect-ratio: 333 / 401;
      overflow-y: auto;
      overflow-x: hidden;
      scroll-snap-type: y mandatory;
      scrollbar-width: none;
    }
    .pieza__galeria::-webkit-scrollbar {
      display: none;
    }
    .pieza__foto {
      scroll-snap-align: start;
      scroll-snap-stop: always;
      flex-shrink: 0;
      box-sizing: border-box;
      width: 100%;
      height: 100%;
      margin-bottom: 0;
      /* Padding del diseño — la foto queda enmarcada a los lados, no
         edge-to-edge; se ve el fondo de la página (--color-bg). Sin padding
         arriba/abajo: la foto llega hasta ambos bordes de su "página" del
         carrete. */
      padding: 0 var(--gutter);
    }
    .pieza__foto:first-child {
      /* Ahora la controla el contenedor (.pieza__galeria) por igual para
         todas las fotos, no solo la primera. */
      aspect-ratio: auto;
    }
    .pieza__foto img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Título + Inquire en la misma línea, arriba de la columna de info —
       el botón de Inquire de abajo (al fondo, con el resto del contenido)
       se oculta; es el mismo #inquire-open handler, solo cambia cuál de
       los dos triggers se ve según el breakpoint. */
    .pieza__title-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 24px;
    }
    .pieza__title-row:has(+ .pieza__badge) {
      margin-bottom: 6px;
    }
    .pieza__title-row h1 {
      margin-bottom: 0;
    }
    .pieza__inquire-top {
      display: inline-block;
      flex-shrink: 0;
      font-size: var(--fs-body);
      font-weight: var(--fw-medium);
      letter-spacing: 0.4px;
      text-transform: uppercase;
      text-decoration: underline;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      appearance: none;
      outline: none;
    }
    .pieza__info > .inquire {
      display: none;
    }
  }
</style>

<style is:global>
  body.no-scroll {
    overflow: hidden;
  }

  .lightbox__close,
  .lightbox__arrow,
  .inquire-modal__close,
  .inquire-modal button[type="submit"] {
    appearance: none;
    outline: none;
  }
  .lightbox__close:focus-visible,
  .lightbox__arrow:focus-visible,
  .inquire-modal__close:focus-visible,
  .inquire-modal button[type="submit"]:focus-visible {
    outline: 1px solid var(--color-hairline);
    outline-offset: 4px;
  }

  /* Lightbox — valores exactos de Figma (blureamos lo que hay detrás del
     modal, la página, no la foto misma). */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(160, 160, 160, 0.2);
    /* Safari necesita el prefijo -webkit- para backdrop-filter. */
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .lightbox.is-visible {
    opacity: 1;
    pointer-events: auto;
  }
  .lightbox__stage {
    /* Más grande que la columna de foto en la vista de pieza/colección
       (--photo-col, ~45% del content-box) — el zoom debe sentirse como un
       salto real de tamaño. */
    position: relative;
    max-width: min(88vw, 1300px);
    max-height: 96vh;
  }
  .lightbox__stage img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 96vh;
    object-fit: contain;
  }
  .lightbox__close {
    position: absolute;
    top: 32px;
    right: var(--gutter);
    width: 20px;
    height: 20px;
    background: none;
    border: none;
    cursor: pointer;
  }
  .lightbox__close span {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--color-text);
  }
  .lightbox__close span:first-child {
    transform: rotate(45deg);
  }
  .lightbox__close span:last-child {
    transform: rotate(-45deg);
  }
  .lightbox__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
  }
  .lightbox__arrow--prev {
    left: 24px;
  }
  .lightbox__arrow--next {
    right: 24px;
  }
  .lightbox__arrow span {
    display: block;
    width: 9px;
    height: 9px;
    border-top: 1px solid var(--color-text);
    border-right: 1px solid var(--color-text);
  }
  .lightbox__arrow--prev span {
    transform: rotate(-135deg);
    margin-left: 3px;
  }
  .lightbox__arrow--next span {
    transform: rotate(45deg);
    margin-right: 3px;
  }

  /* En mobile se navega con swipe (ver el script) — las flechas sobran. */
  @media (max-width: 900px) {
    .lightbox__arrow {
      display: none;
    }
  }

  /* Modal de Inquire */
  /* Mismo fondo que el lightbox de la galería (valores de Figma). */
  .inquire-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(160, 160, 160, 0.2);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .inquire-modal.is-visible {
    opacity: 1;
    pointer-events: auto;
  }
  .inquire-modal__panel {
    position: relative;
    width: min(90vw, 420px);
    background: var(--color-placeholder);
    padding: 32px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
  }
  .inquire-modal__close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 16px;
    height: 16px;
    background: none;
    border: none;
    cursor: pointer;
  }
  .inquire-modal__close span {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--color-text);
  }
  .inquire-modal__close span:first-child {
    transform: rotate(45deg);
  }
  .inquire-modal__close span:last-child {
    transform: rotate(-45deg);
  }
  .inquire-modal form {
    display: flex;
    flex-direction: column;
    gap: 20px;
