---
import Base from "../../layouts/Base.astro";
import WorkGrid from "../../components/WorkGrid.astro";
import { getCollection } from "astro:content";

// Work es el catálogo completo: a diferencia del home slider (curado a mano
// en su propia colección), aquí se listan todas las piezas y colecciones,
// sin paginación — todo se renderiza de una sola vez.
const piezas = (await getCollection("piezas")).map((p) => ({
  ...p.data,
  type: "pieces" as const,
  _order: p.data.orden ?? 999,
}));

const colecciones = (await getCollection("colecciones")).map((c) => ({
  ...c.data,
  type: "collections" as const,
  _order: c.data.orden ?? 999,
}));

const items = [...piezas, ...colecciones].sort((a, b) => a._order - b._order);
---
<Base
  title="Work"
  description="Browse the full catalog of furniture and objects by Daniel Couttolenc — solid wood and cast bronze pieces and collections."
>
  <WorkGrid items={items} />
</Base>
